# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/master/Unity.gitignore
#
/DrawLiar/[Ll]ibrary/
/DrawLiar/[Tt]emp/
/DrawLiar/[Oo]bj/
/DrawLiar/[Bb]uild/
/DrawLiar/[Bb]uilds/
/DrawLiar/[Ll]ogs/
/DrawLiar/[Mm]emoryCaptures/
/DrawLiar/[Uu]serSettings/

# Asset Store packages are kept locally, not redistributed in this public repository.
/DrawLiar/Assets/Feel/
/DrawLiar/Assets/Feel.meta
/DrawLiar/Assets/Dissonance/
/DrawLiar/Assets/Dissonance.meta
/DrawLiar/Assets/Plugins/Dissonance/
/DrawLiar/Assets/Plugins/Dissonance.meta
/DrawLiar/Assets/Plugins/Demigiant/
/DrawLiar/Assets/Plugins/Demigiant.meta
/DrawLiar/Assets/I2/
/DrawLiar/Assets/I2.meta


# ReferenceFiles
/ReferenceFiles/
/Docs/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.unityproj
*.csproj
*.sln
*.slnx
!/Tools/ResourcePatchTool/**/*.csproj
!/Tools/ResourcePatchTool/*.sln
!/Server/**/*.csproj
!/Server/**/*.sln
*.suo
*.tmp
~$*.xlsx
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt
*.stackdump
.DS_Store
.DS_Store.meta

# Builds
*.apk
*.unitypackage
/Build/
/*_BackUpThisFolder_ButDontShipItWithYourGame/
/*_BurstDebugInformation_DoNotShip/
/DrawLiar/Assets/_Recovery/
/DrawLiar/Assets/_Recovery.meta

# Output
/Tools/Preview/
/DrawLiar/output/
/DrawLiar/.utmp/
/.codex-temp/
/Private/
/Server/**/bin/
/Server/**/obj/
/Tools/**/__pycache__/
/Tools/Firebase/node_modules/
/Tools/Docker/.env
*.pfx
*.p12
*.key
/Tools/NetworkSelfTest/bin/
/Tools/NetworkSelfTest/obj/
!/Tools/NetworkSelfTest/NetworkSelfTest.csproj
/Tools/ItemInventoryDbCheck/bin/
/Tools/ItemInventoryDbCheck/obj/
!/Tools/ItemInventoryDbCheck/ItemInventoryDbCheck.csproj
/Tools/ItemInventoryCheck/
/Tools/ItemInventoryWork/
/Tools/QuestWork/

# Crashlytics generated file
crashlytics-build.properties



# Unity 6는 아래 확장자를 에셋으로 임포트하지 않아 .meta를 만들지 않는다.
# 예전 버전이나 다른 툴이 다시 만들어도 올라가지 않게 막는다.
*.unitypackage.meta
*.csproj.meta
*.sln.meta

# Unity가 자동 생성하는 사본. 실제로 쓰는 설정은 Assets/Settings 아래에 있다.
/DrawLiar/Assets/UniversalRenderPipelineGlobalSettings.asset
/DrawLiar/Assets/UniversalRenderPipelineGlobalSettings.asset.meta
/DrawLiar/Assets/DefaultVolumeProfile.asset
/DrawLiar/Assets/DefaultVolumeProfile.asset.meta

# Unity AI 어시스턴트가 만드는 빈 파일
/DrawLiar/Assets/AssistantCustomInstructions.txt
/DrawLiar/Assets/AssistantCustomInstructions.txt.meta

# I2가 자동 생성하는 빈 기본 소스
/DrawLiar/Assets/Resources.meta
/DrawLiar/Assets/Resources/I2Languages.asset
/DrawLiar/Assets/Resources/I2Languages.asset.meta
