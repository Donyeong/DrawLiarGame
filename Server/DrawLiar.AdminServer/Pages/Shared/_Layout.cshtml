<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - DrawLiar Admin</title>
    <link rel="stylesheet" href="vendor/tabler/tabler.min.css" />
    <link rel="stylesheet" href="console.css" />
</head>
<body>
    <div class="page">
        <aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="메뉴 열기">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a class="navbar-brand" href="./" aria-label="DrawLiar 운영 현황">
                    <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5 4 4M4 20l4-1L20 7a2.8 2.8 0 0 0-4-4L4 15z"/><path d="M4 15 9 20"/></svg></span>
                    <span>DrawLiar<small>ADMIN CONSOLE</small></span>
                </a>
                <div class="collapse navbar-collapse" id="sidebar-menu">
                    <ul class="navbar-nav pt-lg-3">
                        <li class="nav-section">Operations</li>
                        <li class="nav-item"><a class="nav-link active" href="#overview" data-section="overview" aria-current="page"><span class="nav-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 4h6v9H4zm0 11h6v5H4zm10-4h6v9h-6zm0-7h6v5h-6z"/></svg></span><span class="nav-link-title">운영 현황</span></a></li>
                        <li class="nav-item"><a class="nav-link" href="#versions" data-section="versions"><span class="nav-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 20h14v-2H5zm7-18L6.5 7.5l1.42 1.42L11 5.84V16h2V5.84l3.08 3.08 1.42-1.42z"/></svg></span><span class="nav-link-title">클라이언트 버전</span></a></li>
                        <li class="nav-item"><a class="nav-link" href="#rooms" data-section="rooms"><span class="nav-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 2 10 8v12h-7v-7H9v7H2V10zm0 2.56L4 10.96V20h3v-7h10v7h3v-9.04z"/></svg></span><span class="nav-link-title">방 모니터링</span></a></li>
                        <li class="nav-section">Users</li>
                        <li class="nav-item"><a class="nav-link" href="#accounts" data-section="accounts"><span class="nav-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-5 0-9 2.5-9 5.5V22h18v-2.5C21 16.5 17 14 12 14z"/></svg></span><span class="nav-link-title">계정 관리</span></a></li>
                        <li class="nav-item"><a class="nav-link" href="#mail" data-section="mail"><span class="nav-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5z"/></svg></span><span class="nav-link-title">우편 발송</span></a></li>
                        <li class="nav-item"><a class="nav-link" href="#reports" data-section="reports"><span class="nav-link-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 2h2v2h13l-3 5 3 5H7v8H5zm2 4v6h9.46l-1.8-3 1.8-3z"/></svg></span><span class="nav-link-title">신고 관리</span><span id="report-badge" class="badge bg-red-lt ms-auto" hidden></span></a></li>
                    </ul>
                    <div class="sidebar-footer"><span id="connection-dot" class="status-dot bg-secondary"></span><span id="connection-label">연결 확인 중</span></div>
                </div>
            </div>
        </aside>
        <div class="page-wrapper">
            <header class="navbar navbar-expand-md d-print-none">
                <div class="container-xl justify-content-end">
                    <div class="navbar-nav flex-row align-items-center gap-3">
                        <div class="text-end"><div id="admin-name" class="fw-semibold">@User.Identity?.Name</div><div class="text-secondary small">Administrator</div></div>
                        <span class="avatar avatar-sm bg-primary-lt" aria-hidden="true">A</span>
                        <form method="post" action="logout">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary btn-sm" type="submit">로그아웃</button></form>
                    </div>
                </div>
            </header>
            <main class="page-body"><div class="container-xl">@RenderBody()</div></main>
            <footer class="footer footer-transparent d-print-none"><div class="container-xl text-secondary">DrawLiar Operations</div></footer>
        </div>
    </div>
    <script src="vendor/tabler/tabler.min.js"></script>
    @await RenderSectionAsync("Scripts", false)
</body>
</html>
