.app.mobile { padding: 0; background-color: #F7F3EA; color: #34304B; font-size: 16px; --ink: #34304B; --muted: #817A87; --brand: #78679E; --border: #E3DDD4; --mint: #537F70; }
 .app.mobile .mobile-lobby-chat-open { min-height: 48px; flex-shrink: 0; margin-top: 12px; }
 .app.mobile .modal.lobby-chat-modal { height: 82%; max-height: 760px; min-height: 220px; padding: 20px; }
 .mobile .lobby-chat-modal-heading { min-height: 48px; flex-shrink: 0; margin-bottom: 12px; }
 .mobile .lobby-chat-modal-heading > .title { margin: 0; font-size: 24px; }
 .app.mobile .lobby-chat-panel.lobby-chat-in-modal { height: auto; min-height: 0; flex-basis: 0; flex-grow: 1; flex-shrink: 1; }
 .mobile .lobby-chat-heading { min-height: 22px; margin-bottom: 8px; justify-content: flex-end; }
.mobile .lobby-chat-name { width: 96px; min-width: 96px; font-size: 14px; }
.mobile .account-level-badge { width: 20px; height: 20px; min-width: 20px; min-height: 20px; margin-right: 4px; }
.mobile .account-level-number { font-size: 10px; }
.mobile .level-tier-5 .account-level-number { font-size: 8px; }
.mobile .level-name-lobby-chat-name { width: 96px; min-width: 96px; }
.mobile .level-name-shop-profile-name { height: 24px; margin-bottom: 8px; align-self: stretch; }
.mobile-landscape .level-name-shop-profile-name { height: 14px; margin-bottom: 2px; }
.mobile-landscape .level-name-shop-profile-name .account-level-badge { width: 20px; height: 14px; min-width: 20px; min-height: 14px; }
.mobile-landscape .level-name-shop-profile-name .account-level-number { font-size: 8px; }
.mobile-landscape .level-name-shop-profile-name .level-tier-5 .account-level-number { font-size: 6px; }
.mobile.in-game .player .level-name-player-name { height: 16px; }
.app.mobile.in-game .player .level-name-player-name Label.leveled-name { width: auto; min-width: 0; flex-basis: 0; flex-grow: 1; flex-shrink: 1; }
.mobile.in-game .player .level-name-player-name .account-level-badge { width: 20px; height: 14px; min-width: 20px; min-height: 14px; margin-right: 2px; }
.mobile.in-game .player .level-name-player-name .account-level-number { font-size: 8px; }
.mobile.in-game .player .level-name-player-name .level-tier-5 .account-level-number { font-size: 6px; }
.mobile.in-game .level-name-chat-name .account-level-badge { width: 18px; height: 16px; min-width: 18px; min-height: 16px; }
.mobile.in-game .level-name-chat-name .account-level-number { font-size: 9px; }
.mobile.in-game .level-name-chat-name .level-tier-5 .account-level-number { font-size: 6px; }
.mobile .match-experience-reward { font-size: 14px; }
 .mobile .lobby-chat-message { font-size: 14px; }
 .app.mobile .lobby-chat-close { width: 72px; flex-shrink: 0; min-height: 48px; margin: 0; }
.mobile .app-content { min-height: 0; min-width: 0; flex-basis: 0; position: relative; }
.mobile .mobile-hidden { display: none; }
.mobile .mobile-home-scroll, .mobile .mobile-controls-scroll { flex-grow: 1; flex-basis: 0; min-height: 0; min-width: 0; }
.mobile .mobile-home { padding: 16px 20px 20px; min-width: 0; }
.mobile .mobile-home > * { flex-shrink: 0; margin-bottom: 12px; }
.mobile .mobile-login-screen { flex-grow: 1; min-height: 0; justify-content: center; padding: 24px 28px; }
.mobile .mobile-login-visual { flex-shrink: 0; align-items: center; margin-bottom: 32px; }
.mobile .mobile-login-logo { width: 320px; max-width: 100%; height: 128px; flex-shrink: 0; margin: 0; }
.mobile .mobile-login-actions { width: 100%; max-width: 420px; align-self: center; flex-shrink: 0; }
.mobile .mobile-login-actions .guest-login { min-height: 56px; font-size: 19px; margin: 0 0 12px; }
.mobile .mobile-login-actions .google-login { min-height: 52px; background-color: #FFFFFF; margin: 0 0 12px; }
.mobile .mobile-login-actions .google-cancel { margin-bottom: 12px; }
.mobile .mobile-login-actions .language-selection { margin: 8px 0 0; }
.mobile .mobile-login-actions .notice { margin-top: 8px; }
.mobile .mobile-small { font-size: 13px; white-space: normal; }
.mobile .mobile-card-title { font-size: 16px; -unity-font-style: bold; white-space: normal; }
.mobile .mobile-topbar { min-height: 60px; height: 60px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 6px 20px; background-color: #F7F3EA; }
.mobile .mobile-topbar .mobile-back { width: 72px; min-width: 48px; font-size: 14px; padding: 8px 4px; }
.mobile .mobile-topbar .mobile-status-pill { align-self: center; margin-right: 8px; }
.mobile .mobile-topbar .mobile-workspace-title { font-size: 22px; -unity-font-style: bold; margin: 0 8px; padding: 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mobile .mobile-topbar .mobile-lobby-title { margin-left: 0; }
.mobile .mobile-bottom-nav { min-height: 68px; height: 68px; flex-shrink: 0; flex-direction: row; align-items: stretch; justify-content: space-between; padding: 8px 12px; background-color: #FFFFFF; border-top-width: 1px; border-top-color: #E3DDD4; }
.mobile .mobile-bottom-nav .mobile-nav-item { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 48px; height: 48px; padding: 6px 4px; margin: 0 3px; border-width: 0; border-radius: 8px; color: #736957; background-color: #FFFFFF; font-size: 14px; -unity-font-style: normal; -unity-text-align: middle-center; transition-property: scale; }
.mobile .mobile-bottom-nav .mobile-nav-selected { background-color: #F9E6BE; color: #34304B; border-width: 0 0 3px; border-color: #34304B; -unity-font-style: bold; }
.mobile .mobile-lobby { flex-grow: 1; flex-basis: 0; min-height: 0; padding: 4px 20px 12px; }
.mobile .mobile-lobby-profile { height: auto; min-height: 144px; flex-shrink: 0; margin-bottom: 16px; background-color: #FFFFFF; border-width: 2px; border-color: #34304B; border-radius: 12px; padding: 12px 16px; }
.mobile .mobile-lobby-avatar { width: 104px; height: 104px; flex-shrink: 0; margin-right: 16px; align-items: center; justify-content: center; }
.mobile .mobile-lobby-avatar .lobby-avatar { width: 104px; height: 104px; }
.mobile .mobile-lobby-identity { flex-basis: 0; min-width: 0; align-items: flex-start; justify-content: center; }
.mobile .mobile-lobby-name { font-size: 22px; -unity-font-style: bold; max-width: 100%; margin: 0; padding: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mobile .mobile-account-state { font-size: 12px; color: #736957; margin: 4px 0 8px; padding: 0; }
.mobile .button.mobile-customize { min-width: 112px; max-width: 100%; height: 48px; min-height: 48px; flex-shrink: 0; margin: 0; padding: 8px 12px; font-size: 14px; white-space: nowrap; }
.mobile .mobile-lobby-actions { flex-shrink: 0; align-items: stretch; margin-bottom: 12px; }
.mobile .mobile-lobby-actions .button { flex-basis: 0; min-width: 0; height: auto; min-height: 64px; padding: 8px 4px; font-size: 16px; white-space: normal; border-width: 2px 2px 5px 2px; margin-right: 6px; }
.mobile .mobile-lobby-actions .mobile-last { margin-right: 0; }
.mobile .button.menu-mint { background-color: #78BBA4; }
.mobile .button.menu-mint:hover { background-color: #93D0B9; }
.mobile .button.menu-mint:active { background-color: #66A68F; }
.mobile .button.menu-orange { background-color: #F5B553; }
.mobile .button.menu-orange:hover { background-color: #FFCB7B; }
.mobile .button.menu-orange:active { background-color: #EAA843; }
.mobile .button.menu-purple { background-color: #9D93DB; }
.mobile .mobile-room-list-heading { flex-shrink: 0; height: 48px; min-height: 48px; margin-bottom: 12px; }
.mobile .mobile-room-list-heading .mobile-card-title { margin: 0; padding: 0; }
.mobile .mobile-lobby-room-list { flex-grow: 1; flex-basis: 0; min-height: 0; height: auto; margin-top: 0; }
.mobile .room-list-empty-message { font-size: 14px; }
.mobile .friend-actions .button.icon-button { margin-left: 8px; }
.mobile .mobile-section-header { flex-direction: row; align-items: center; justify-content: space-between; font-size: 16px; -unity-font-style: bold; margin: 4px 0 12px; }
.mobile .mobile-status-pill { align-self: flex-start; background-color: #F9E6BE; color: #736957; padding: 5px 10px; border-radius: 8px; font-size: 12px; -unity-font-style: bold; white-space: nowrap; }
.mobile .mobile-profile-hero { flex-direction: row; align-items: center; min-height: 124px; flex-shrink: 0; margin: 0 20px 12px; padding: 12px; background-color: #FFFFFF; border-width: 1px; border-color: #E3DDD4; border-radius: 16px; }
.mobile .mobile-profile-preview { width: 104px; height: 104px; flex-shrink: 0; margin-right: 12px; align-items: center; justify-content: center; background-color: #FFF3D8; border-radius: 12px; }
.mobile .mobile-profile-preview .lobby-avatar { width: 104px; height: 104px; }
.mobile .mobile-profile-hero .grow { min-width: 0; }
.mobile .mobile-profile-hero .rules { font-size: 12px; margin: 0 0 8px; }
.mobile .mobile-profile-hero .button { min-height: 48px; padding: 8px 10px; font-size: 14px; }
.mobile .home-panel { width: 100%; max-width: none; flex-shrink: 0; }
.mobile .mobile-page-body > * { margin-bottom: 12px; }
.mobile .mobile-page-body > .screen-title { display: none; }
.mobile .screen-title { font-size: 24px; margin-bottom: 12px; }
.mobile .mobile-page-heading { align-items: center; margin-bottom: 12px; }
.mobile .mobile-back { width: 64px; min-width: 64px; flex-shrink: 0; margin: 0; }
.mobile .button { min-height: 48px; height: auto; font-size: 16px; border-radius: 10px; padding: 10px 14px; border-width: 2px 2px 4px 2px; border-color: #34304B; color: #34304B; background-color: #FFF9ED; margin: 0; white-space: normal; transition-property: background-color, border-color; transition-duration: .12s; }
.mobile .button:hover { background-color: #FFF0C7; border-color: #34304B; }
.mobile .button:active { background-color: #F2E6CA; border-color: #34304B; }
.mobile .button:focus { border-color: #645797; }
.mobile .mobile-home > .button, .mobile .mobile-page-body > .button { margin-bottom: 12px; }
.mobile .primary { background-color: #F5B553; border-color: #34304B; color: #34304B; }
.mobile .primary:hover { background-color: #F8C36F; border-color: #34304B; }
.mobile .primary:active { background-color: #EAA843; border-color: #34304B; }
.mobile .secondary { background-color: #FFF9ED; border-color: #34304B; color: #34304B; }
.mobile .danger { color: #9B4A54; background-color: #FAE9E5; border-color: #EBD1CB; }
.mobile .next-button { margin-top: 12px; height: 48px; }
.mobile .field { flex-direction: column; align-items: stretch; min-height: 72px; margin: 0 0 12px; font-size: 16px; }
.mobile .field > .unity-base-field__label { min-width: 0; width: auto; align-self: flex-start; margin: 0 0 6px; font-size: 13px; color: #817A87; }
.mobile .audio-label { font-size: 16px; }
.mobile .audio-volume { margin-bottom: 10px; }
.mobile .audio-slider { height: 48px; min-height: 48px; }
.mobile .audio-slider .unity-base-slider__tracker { background-color: #D8D0DF; }
.mobile .audio-slider .unity-base-slider__dragger { width: 24px; height: 24px; border-radius: 12px; background-color: #78679E; }
.mobile .unity-base-text-field__input, .mobile .unity-base-popup-field__input { min-height: 48px; border-width: 2px; border-color: #B7A88B; border-radius: 8px; padding: 10px 14px; background-color: #FFFDF6; color: #34304B; font-size: 16px; }
.mobile .unity-base-text-field__input:focus, .mobile .unity-base-popup-field__input:focus { border-color: #78679E; }
.mobile .unity-toggle { min-height: 48px; flex-direction: row; align-items: center; }
.mobile .unity-toggle > .unity-base-field__label { align-self: center; margin: 0 12px 0 0; flex-grow: 1; }
.mobile .unity-toggle__input { min-width: 40px; min-height: 48px; }
.mobile .time-form .field { flex-direction: column; min-height: 72px; }
.mobile .time-form .field > .unity-base-field__label { width: auto; }
.mobile .form-column { width: 50%; padding-right: 8px; }
.mobile .room-list { height: 360px; margin-top: 8px; }
.mobile .room-entry, .mobile .mobile-room-item { flex-direction: column; align-items: stretch; padding: 14px; background-color: #FFFFFF; border-width: 1px; border-color: #E3DDD4; border-radius: 16px; margin-bottom: 12px; }
.mobile .mobile-room-item { flex-shrink: 0; }
.mobile .mobile-room-item > .room-entry-info { flex-grow: 0; flex-basis: auto; }
.mobile .mobile-room-item .room-entry-info > * { flex-shrink: 0; }
.mobile .room-entry > *, .mobile .mobile-room-item > * { flex-shrink: 0; margin-bottom: 8px; }
.mobile .room-entry .player-name, .mobile .mobile-room-item .player-name { font-size: 18px; white-space: normal; }
.mobile .mobile-room-top { flex-direction: row; align-items: center; min-width: 0; }
.mobile .mobile-room-top .grow { flex-basis: 0; flex-shrink: 1; min-width: 0; margin-right: 8px; }
.mobile .mobile-room-meta { font-size: 13px; color: #817A87; white-space: normal; }
.mobile .mobile-room-metadata { justify-content: flex-start; flex-wrap: wrap; }
.mobile .mobile-room-metadata .mobile-small { margin-right: 12px; }
.mobile .mobile-room-state { color: #537F70; background-color: #E6F1EB; padding: 4px 8px; border-radius: 6px; font-size: 12px; flex-shrink: 0; }
.mobile .mobile-room-action { flex-direction: row; align-items: center; margin-bottom: 0; }
.mobile .mobile-room-action .primary { flex-grow: 1; flex-basis: 0; }
.mobile .mobile-room-action .secondary { width: 76px; flex-shrink: 0; margin-left: 8px; }
.mobile .mobile-room-entry-actions { align-items: stretch; margin-bottom: 0; }
.mobile .mobile-room-entry-actions .button { min-width: 72px; margin: 0 0 0 8px; white-space: nowrap; }
.mobile .mobile-room-entry-actions .mobile-room-entry-first { margin-left: 0; }
.mobile .mobile-room-entry-actions .secondary { width: auto; min-width: 88px; padding: 8px 12px; font-size: 14px; }
.mobile .mobile-code-input .unity-base-text-field__input { -unity-font-style: bold; font-size: 24px; -unity-text-align: middle-center; }
.mobile .mobile-join-code-row { align-items: flex-end; margin-bottom: 12px; }
.mobile .mobile-join-code-row .field { margin: 0 12px 0 0; min-width: 0; flex-basis: 0; }
.mobile .mobile-code-paste { width: 96px; min-height: 48px; flex-shrink: 0; font-size: 14px; padding: 8px; }
.mobile .mobile-join-actions .button { flex-basis: 0; min-width: 0; min-height: 52px; margin-right: 12px; }
.mobile .mobile-join-actions .mobile-last { margin-right: 0; }
.mobile .shop-entry, .mobile .room-entry, .mobile .mobile-room-item { transition-property: background-color, border-color; transition-duration: .12s; }
.mobile .topic-list { height: 280px; }
.mobile .topic-toggle { width: 46%; min-height: 48px; font-size: 16px; background-color: #FFFFFF; border-color: #DED5EA; color: #817A87; }
.mobile .topic-toggle.topic-selected { background-color: #E9E4F3; border-color: #78679E; color: #34304B; }
.mobile .avatar-colors { flex-wrap: wrap; }
.mobile .avatar-colors .swatch { width: 48px; height: 48px; min-height: 48px; margin: 0 8px 8px 0; padding: 0; }
.mobile .equipment-option { min-height: 136px; margin: 0 2% 8px 0; padding: 8px; font-size: 16px; background-color: #FFFFFF; border-color: #E3DDD4; }
.mobile .part-tabs { height: auto; min-height: 56px; }
.mobile .part-tabs .part-tab { min-width: 52px; height: 48px; min-height: 48px; margin: 0 6px 6px 0; padding: 6px 10px; font-size: 14px; }
.mobile .equipment-option.equipped { background-color: #E9E4F3; border-color: #78679E; }
.mobile .equipment-state { white-space: normal; }
.mobile .rules, .mobile .notice { font-size: 13px; color: #817A87; white-space: normal; }
.mobile .overlay { justify-content: flex-end; align-items: stretch; background-color: rgba(52,48,75,.38); }
.mobile .modal { width: 100%; max-width: 100%; max-height: 90%; padding: 0; background-color: #FFFFFF; color: #34304B; border-width: 1px; border-color: #E3DDD4; border-radius: 20px 20px 0 0; }
.mobile .mobile-modal-scroll { min-height: 0; flex-shrink: 1; }
.app.mobile .modal.room-options-editor { padding: 20px; }
.mobile .mobile-modal-body { padding: 20px; }
.mobile .mobile-modal-body > * { flex-shrink: 0; margin-bottom: 10px; }
.mobile .mobile-modal-body .title { font-size: 24px; }
.mobile .mobile-modal-body .button { margin-top: 0; }
.mobile .toast { left: 20px; right: 20px; bottom: 80px; max-width: none; font-size: 14px; padding: 12px 16px; border-width: 0; border-radius: 12px; background-color: #34304B; color: #FFFFFF; }
.app.mobile.in-game { padding: 0; background-color: #F7F3EA; color: #34304B; --ink: #34304B; --muted: #817A87; --brand: #78679E; --border: #E3DDD4; --mint: #537F70; }
.mobile.in-game .mobile-room { flex-grow: 1; min-height: 0; padding: 12px 16px; }
.mobile.in-game .room-hud { height: 48px; min-height: 48px; margin-bottom: 8px; align-items: center; }
.mobile.in-game .room-hud .mobile-back { width: auto; min-width: 64px; white-space: nowrap; }
.mobile.in-game .phase-bar { justify-content: flex-start; min-height: 48px; }
.mobile.in-game .phase-title { font-size: 20px; }
.mobile.in-game .phase-detail { display: none; }
.mobile.in-game .timer { font-size: 18px; -unity-font-style: bold; color: #78679E; margin-right: 8px; }
.mobile.in-game .timer-urgent { color: #BD594A; }
.app.mobile .hud-timer { width: 96px; min-width: 96px; margin-right: 8px; }
.app.mobile .game-timer .timer.timer-value { font-size: 26px; }
.app.mobile .guess-timer-control { width: 96px; min-width: 96px; }
.mobile.in-game .mobile-round-card { padding: 2px 12px; min-height: 52px; border-radius: 12px; background-color: #FFFFFF; border-width: 1px; border-color: #E3DDD4; align-items: center; margin-bottom: 8px; flex-shrink: 0; }
.mobile.in-game .mobile-round-card .mobile-small { margin-top: 4px; }
.mobile.in-game .mobile-round-card > .grow { min-width: 0; flex-basis: 0; }
.mobile-waiting-room-title { max-width: 100%; min-width: 0; margin: 0 0 4px; padding: 0; font-size: 18px; -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mobile-room-info-actions { flex-shrink: 0; margin-left: 8px; align-items: stretch; }
.app.mobile .mobile-room-info-actions .mobile-code-copy { margin: 0; }
.app.mobile .mobile-room-info-actions .waiting-room-topics { height: 44px; min-height: 44px; min-width: 88px; margin: 4px 0 0; padding: 4px 8px; font-size: 12px; }
.mobile.in-game .mobile-code-copy { width: 108px; flex-shrink: 0; padding: 8px; font-size: 14px; }
.mobile.in-game .secret-bar { margin-bottom: 8px; padding: 10px 12px; min-height: 72px; border-radius: 12px; border-width: 1px; border-color: #DED5EA; background-color: #EEE8F5; flex-shrink: 0; }
.mobile.in-game .topic { font-size: 12px; color: #817A87; margin: 0 0 4px; }
.mobile.in-game .mobile-role-line { align-items: center; min-height: 26px; }
.mobile.in-game .role { font-size: 15px; color: #78679E; border-width: 0; padding: 0; margin: 0 8px 0 0; }
.mobile.in-game .word, .mobile.in-game .word-hidden { font-size: 18px; color: #34304B; margin: 0; }
.mobile.in-game .secret-toggle { min-height: 48px; height: 48px; padding: 8px; font-size: 13px; background-color: #FFFFFF; color: #78679E; }
.mobile.in-game .mobile-workspace { flex-grow: 1; min-height: 0; flex-direction: column; }
.mobile.in-game .mobile-workspace-title { min-height: 24px; font-size: 13px; color: #817A87; margin: 0 0 8px; }
.mobile.in-game .canvas-frame { width: 100%; min-height: 0; flex-grow: 0; flex-shrink: 0; border-width: 1px; border-color: #E3DDD4; border-radius: 12px; background-color: #FFFFFF; margin-bottom: 8px; }
.mobile.in-game .drawing-surface { background-color: #FFFFFF; }
.mobile.in-game .mobile-controls { min-width: 0; padding-bottom: 0; }
.mobile.in-game .mobile-controls > * { flex-shrink: 0; margin-bottom: 8px; }
.mobile.in-game .mobile-bottom-actions { flex-shrink: 0; padding-top: 4px; }
.mobile.in-game .button { min-height: 48px; height: auto; padding: 8px 12px; border-radius: 10px; border-width: 2px 2px 4px 2px; font-size: 16px; background-color: #FFF9ED; border-color: #34304B; color: #34304B; }
.mobile.in-game .button:hover { background-color: #FFF0C7; border-color: #34304B; }
.mobile.in-game .button:active { background-color: #F2E6CA; border-color: #34304B; }
.mobile.in-game .primary, .mobile.in-game .tool-selected { background-color: #F5B553; border-color: #34304B; color: #34304B; }
.mobile.in-game .primary:hover, .mobile.in-game .tool-selected:hover { background-color: #F8C36F; border-color: #34304B; }
.mobile.in-game .primary:active { background-color: #EAA843; border-color: #34304B; }
.mobile.in-game .secondary { background-color: #FFF9ED; border-color: #34304B; color: #34304B; }
.mobile.in-game .danger { color: #9B4A54; background-color: #FAE9E5; border-color: #EBD1CB; }
.mobile.in-game .tool-row { margin-bottom: 8px; }
.mobile.in-game .tool-row .button { width: auto; flex-basis: 0; flex-grow: 1; margin-right: 8px; }
.mobile.in-game .tool-row .button.mobile-last { margin-right: 0; }
.mobile.in-game .mobile-palette-scroll { height: 48px; background-color: #FFFFFF; border-width: 1px; border-color: #E3DDD4; border-radius: 12px; }
.mobile.in-game .palette { width: auto; max-width: none; height: 48px; flex-wrap: nowrap; justify-content: flex-start; align-items: center; padding: 0; }
.mobile.in-game .palette .swatch { width: 48px; height: 48px; min-height: 48px; flex-shrink: 0; margin: 0 4px 0 0; padding: 0; border-radius: 24px; justify-content: center; align-items: center; border-color: transparent; }
.mobile.in-game .palette .swatch.selected, .mobile.in-game .palette .swatch:focus { border-color: #78679E; }
.mobile.in-game .mobile-swatch-dot { width: 28px; height: 28px; border-radius: 14px; flex-shrink: 0; }
.mobile.in-game .mobile-swatch-dot.white-brush-dot { border-width: 1px; border-color: #D8D1DB; }
