:root { -unity-font: resource("DrawLiar/Pretendard-Regular"); color: #34304B; font-size: 15px; --ink: #34304B; --muted: #736957; --brand: #645797; --soft: #eee4c9; --border: #b7a88b; --mint: #237c62; }
 .pc-lobby { flex-grow: 1; min-height: 0; min-width: 0; padding: 24px; overflow: hidden; }
 .pc-lobby-header { height: 56px; min-height: 56px; flex-shrink: 0; margin-bottom: 24px; }
 .app .pc-lobby-workspace { flex-basis: 0; min-width: 0; align-items: stretch; }
 .pc-lobby-sidebar { width: 300px; flex-shrink: 0; margin-right: 24px; }
 .pc-lobby-main { flex-basis: 0; min-width: 0; }
 .pc-lobby-card { background-color: #FFFFFF; border-width: 2px; border-color: #34304B; border-radius: 12px; padding: 20px; }
 .pc-lobby-profile { height: 330px; flex-shrink: 0; align-items: center; margin-bottom: 16px; }
 .pc-lobby-avatar { width: 128px; height: 128px; flex-shrink: 0; margin-bottom: 16px; align-items: center; justify-content: center; }
 .app .pc-lobby-avatar .lobby-avatar { width: 128px; height: 128px; }
 .pc-lobby-name { font-size: 20px; -unity-font-style: bold; max-width: 100%; margin: 0 0 16px; padding: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
 .pc-lobby-account { font-size: 14px; color: #736957; margin: 0 0 16px; padding: 0; }
 .app .pc-lobby .button { height: 48px; min-height: 48px; flex-shrink: 0; font-size: 16px; margin: 0; padding: 8px 16px; }
 .pc-lobby-customize { align-self: stretch; }
 .app .pc-lobby-services .button { margin-bottom: 16px; }
 .app .pc-lobby-services .button.pc-lobby-service-last { margin-bottom: 0; }
 .pc-lobby-rooms { flex-basis: 0; margin-bottom: 16px; }
 .pc-lobby-room-heading { min-height: 48px; flex-shrink: 0; margin-bottom: 16px; }
 .pc-lobby-room-heading .section-title { flex-basis: 0; min-width: 0; font-size: 20px; margin: 0; padding: 0; }
 .app .pc-lobby-room-actions { flex-grow: 3; flex-basis: 0; min-width: 0; align-items: stretch; margin-left: 12px; }
 .app .pc-lobby-room-actions .button { flex-basis: 0; flex-grow: 1; flex-shrink: 1; min-width: 0; height: auto; min-height: 48px; margin: 0 8px 0 0; padding: 8px; white-space: normal; }
 .app .pc-lobby-room-actions .mobile-last { margin-right: 0; }
 .pc-lobby .room-search { margin-bottom: 16px; }
 .app .pc-lobby .room-search .room-refresh { margin-left: 8px; }
 .app .pc-lobby-room-list { flex-basis: 0; height: auto; min-height: 0; margin: 0; }
 .pc-lobby .room-entry { min-height: 80px; flex-shrink: 0; background-color: #FFF9ED; border-color: #E7DDC7; border-radius: 9px; padding: 12px 16px; margin-bottom: 8px; }
 .app .pc-lobby .room-entry .button { min-width: 80px; margin-left: 16px; }
 .pc-lobby .room-entry .player-name { font-size: 16px; margin: 0 0 8px; padding: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
 .pc-lobby .room-entry .muted { font-size: 14px; margin: 0; padding: 0; }
 .lobby-chat-panel { height: 288px; flex-shrink: 0; min-width: 0; }
 .lobby-chat-heading { min-height: 30px; flex-shrink: 0; margin-bottom: 12px; }
 .lobby-chat-heading .section-title { font-size: 20px; margin: 0; padding: 0; }
 .lobby-chat-count { font-size: 14px; margin: 0; padding: 0; }
 .lobby-chat-status { flex-shrink: 0; font-size: 13px; margin-bottom: 4px; white-space: normal; }
 .lobby-chat-history { flex-grow: 1; flex-basis: 0; min-height: 0; min-width: 0; }
 .lobby-chat-history .unity-scroll-view__content-container { flex-shrink: 0; }
 .lobby-chat-line { flex-direction: row; flex-shrink: 0; align-items: flex-start; margin-bottom: 8px; min-width: 0; }
 .lobby-chat-name { width: 160px; min-width: 160px; flex-shrink: 0; margin: 0 8px 0 0; padding: 0; font-size: 16px; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
 .lobby-chat-message { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0; padding: 0; font-size: 16px; white-space: normal; }
 .lobby-chat-composer { flex-shrink: 0; min-height: 48px; margin-top: 12px; }
 .app .lobby-chat-composer .lobby-chat-input { height: 48px; min-height: 48px; min-width: 0; flex-basis: 0; margin: 0; padding: 0; }
 .app .lobby-chat-composer .lobby-chat-send { height: 48px; min-height: 48px; min-width: 96px; flex-shrink: 0; margin: 0 0 0 8px; padding: 8px 16px; font-size: 16px; }
 .app.compact .pc-lobby-sidebar { width: 260px; margin-right: 16px; }
 .app.compact .pc-lobby-header { margin-bottom: 16px; }
 .app.compact .pc-lobby-profile { height: 310px; }
 .app.compact .pc-lobby-card { padding: 16px; }
 .app.compact .lobby-chat-panel { height: 240px; }
.app { flex-grow: 1; background-color: #FFF3D8; padding: 24px 32px 20px 32px; }
.row { flex-direction: row; align-items: center; }
.spread { justify-content: space-between; }
.grow { flex-grow: 1; min-height: 0; }
.header { height: 60px; flex-shrink: 0; margin-bottom: 12px; }
.header-logo { width: 172px; height: 60px; flex-shrink: 0; }
.eyebrow { font-size: 13px; color: var(--muted); -unity-font-style: bold; margin-bottom: 7px; }
.muted { color: var(--muted); font-size: 13px; }
.small { font-size: 12px; }
.title { font-size: 29px; -unity-font-style: bold; margin-bottom: 10px; }
.subtitle { font-size: 17px; color: var(--muted); margin-bottom: 20px; white-space: normal; }
.button { border-radius: 9px; padding: 9px 18px; margin: 4px; border-width: 2px 2px 4px 2px; border-color: var(--ink); background-color: #FFF9ED; color: var(--ink); -unity-font-style: bold; font-size: 14px; min-height: 40px; transition-property: background-color, scale, translate; transition-duration: .16s; }
.button:hover { background-color: #fff0c7; translate: 0 -3px; }
.button:active { scale: 0.97 0.97; translate: 0 2px; }
.button:disabled { opacity: .4; }
.app .button.icon-button { width: 48px; min-width: 48px; max-width: 48px; height: 48px; min-height: 48px; max-height: 48px; flex-grow: 0; flex-shrink: 0; flex-basis: auto; margin: 0; padding: 0; align-items: center; justify-content: center; }
.draw-ui-icon { width: 24px; min-width: 24px; height: 24px; min-height: 24px; flex-shrink: 0; color: #34304B; }
.app .button.social-bell { margin-right: 8px; overflow: visible; }
.social-badge { position: absolute; right: -6px; top: -6px; min-width: 22px; height: 22px; padding: 1px 5px; border-width: 2px; border-color: #F7F3EA; border-radius: 11px; background-color: #BD594A; color: #FFFFFF; font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-center; }
.primary { background-color: #F5B553; color: var(--ink); }
.primary:hover { background-color: #ffc975; }
.secondary { background-color: #FFF9ED; }
.danger { color: #984951; background-color: #f6d4cc; }
.at-home { padding: 0; }
.home { flex-grow: 1; justify-content: center; align-items: center; overflow: hidden; }
.home-layout { width: 1320px; max-width: 92%; flex-direction: row; align-items: center; justify-content: space-between; }
.character-side { width: 46%; align-items: center; justify-content: center; padding: 20px 0; }
.game-logo { width: 480px; max-width: 100%; height: 192px; flex-shrink: 0; margin: 0; }
.guest-login, .google-login { min-height: 52px; font-size: 18px; margin: 0 0 12px; }
.language-selection { margin-top: 12px; }
.character-stage { width: 100%; height: 374px; align-items: center; justify-content: center; }
.lobby-avatar { width: 400px; height: 400px; flex-shrink: 0; }
.character-name { font-size: 23px; -unity-font-style: bold; margin-bottom: 15px; max-width: 90%; overflow: hidden; text-overflow: ellipsis; }
.customize-button { min-width: 214px; height: 52px; font-size: 18px; background-color: #FFF9ED; }
.home-panel { width: 50%; max-width: 630px; flex-shrink: 0; }
.lobby-heading { min-height: 48px; flex-shrink: 0; margin-bottom: 12px; }
.lobby-title { font-size: 28px; -unity-font-style: bold; margin: 0; padding: 0; }
.lobby-coins { margin-right: 8px; padding: 5px 10px; border-radius: 8px; background-color: #F9E6BE; color: #736957; font-size: 13px; white-space: nowrap; }
.lobby-actions { flex-shrink: 0; align-items: stretch; margin-bottom: 12px; }
.lobby-actions .button { flex-basis: 0; min-width: 0; min-height: 52px; margin: 0 8px 0 0; padding: 8px 10px; font-size: 18px; white-space: normal; }
.lobby-actions .mobile-last { margin-right: 0; }
.lobby-room-heading { height: 48px; flex-shrink: 0; margin-bottom: 8px; }
.lobby-room-heading .section-title { margin: 0; padding: 0; }
.room-search { flex-shrink: 0; align-items: center; margin-bottom: 12px; }
.app .room-search .field.room-search-input { flex-basis: 0; flex-grow: 1; min-width: 0; height: 48px; min-height: 48px; margin: 0; padding: 0; }
.app .room-search .room-search-submit { height: 48px; min-height: 48px; min-width: 72px; flex-shrink: 0; margin: 0 0 0 8px; padding: 8px 12px; font-size: 14px; }
.lobby-panel .lobby-room-list { height: 300px; margin-top: 0; }
.lobby-room-list .room-entry .grow { min-width: 0; }
.lobby-services { margin-top: 12px; }
.lobby-services .button { flex-basis: 0; min-width: 0; margin: 0 8px 0 0; }
.lobby-services .mobile-last { margin-right: 0; }
.menu-orange { background-color: #F5B553; }
.menu-orange:hover { background-color: #ffcb7b; }
.menu-mint { background-color: #78BBA4; }
.menu-mint:hover { background-color: #93d0b9; }
.menu-purple { background-color: #9D93DB; }
.menu-purple:hover { background-color: #b3aae8; }
.screen-heading { align-items: flex-start; margin-bottom: 14px; }
.back-button { padding: 6px 14px; font-size: 17px; margin: 0; min-height: 45px; background-color: #FFF9ED; }
.screen-body { background-color: #FFF9ED; border-width: 3px; border-color: var(--ink); border-radius: 13px; padding: 28px 32px; }
.screen-title { font-size: 34px; -unity-font-style: bold; margin-bottom: 24px; }
.next-button { height: 56px; font-size: 19px; margin: 20px 0 0 0; }
.home-panel .field { flex-direction: column; align-items: stretch; min-height: 72px; margin: 7px 0; font-size: 17px; }
.home-panel .field > .unity-base-field__label { align-self: flex-start; margin: 0 0 8px 0; font-size: 15px; color: var(--ink); }
.home-panel .unity-toggle { flex-direction: row; min-height: 34px; margin: 15px 0; }
.home-panel .unity-toggle > .unity-base-field__label { align-self: center; margin: 0 12px 0 0; flex-grow: 1; }
.home-panel .field.small { font-size: 12px; margin: 4px 0; }
.home-panel .field.small > .unity-base-field__label { font-size: 12px; }
.home-panel .time-form .field { flex-direction: row; min-height: 48px; }
.home-panel .time-form .field > .unity-base-field__label { width: 45%; align-self: center; margin: 0; }
.topic-selection-button { min-height: 58px; margin: 12px 0; font-size: 18px; -unity-text-align: middle-left; }
.topic-count { font-size: 15px; -unity-font-style: bold; }
.topic-list { height: 290px; margin: 14px 0; }
.topic-grid { flex-direction: row; flex-wrap: wrap; padding: 4px 0; }
.topic-toggle { width: 31%; min-height: 60px; margin: 4px 1%; padding: 10px 6px; font-size: 18px; white-space: normal; background-color: #eee8db; color: #736957; border-color: #b7a88b; }
.topic-selected { background-color: #9D93DB; color: var(--ink); border-color: var(--ink); }
.topic-selected:hover { background-color: #b3aae8; }
.section-title { font-size: 18px; -unity-font-style: bold; margin: 15px 0 10px 0; }
.field { margin: 5px 0; min-height: 39px; }
.field > .unity-base-field__label { min-width: 108px; color: var(--muted); align-self: center; }
.audio-options { margin-bottom: 12px; }
.audio-volume { margin-bottom: 8px; }
.audio-label { font-size: 15px; }
.audio-percentage { font-size: 13px; color: var(--muted); }
.audio-slider { height: 40px; min-height: 40px; margin: 0; }
.audio-slider .unity-base-slider__tracker { height: 4px; background-color: #b7a88b; }
.audio-slider .unity-base-slider__dragger { width: 20px; height: 20px; border-radius: 10px; background-color: var(--brand); }
.unity-base-text-field__input, .unity-base-popup-field__input { border-radius: 6px; border-width: 2px; border-color: #b7a88b; background-color: #fffdf6; color: var(--ink); padding: 8px 12px; min-height: 38px; }
.unity-text-field__input:focus { border-color: #645797; }
.form-column { width: 50%; padding-right: 12px; }
.room-list { height: 270px; margin-top: 15px; }
.room-list-empty-state { position: absolute; top: 0; right: 0; bottom: 0; left: 0; align-items: center; justify-content: center; padding: 16px; }
.room-list-empty-message { max-width: 100%; margin: 0; padding: 0; white-space: normal; -unity-text-align: middle-center; }
.room-entry { border-radius: 6px; border-width: 1px; border-color: #b7a88b; background-color: #f6eedb; padding: 10px; margin-bottom: 10px; flex-direction: row; justify-content: space-between; align-items: center; }
.part-tabs { height: auto; min-height: 52px; flex-shrink: 0; flex-direction: row; flex-wrap: wrap; align-items: flex-start; margin-bottom: 12px; }
.part-tabs .part-tab { min-width: 60px; height: 44px; min-height: 44px; flex-shrink: 0; margin: 0 6px 6px 0; padding: 6px 12px; font-size: 14px; white-space: nowrap; }
.part-tabs .part-tab.part-selected { background-color: #E9E4F3; border-color: #78679E; }
.part-tabs .part-tab.part-selected:hover { background-color: #F0E9FB; }
.notice { white-space: normal; color: #866d51; margin: 12px 0 0 0; font-size: 13px; }
.player-name { -unity-font-style: bold; font-size: 13px; overflow: hidden; text-overflow: ellipsis; }
.swatch { width: 25px; height: 25px; min-height: 0; padding: 0; margin: 4px; border-radius: 13px; border-width: 2px; border-color: rgba(52,48,75,.2); }
.swatch.selected { border-color: var(--ink); scale: 1.12 1.12; }
.avatar-colors { margin-bottom: 20px; padding: 4px; overflow: visible; }
.avatar-colors .swatch { width: 48px; height: 48px; margin: 5px 13px 5px 0; border-radius: 25px; border-width: 3px; }
.customize-scroll { height: 510px; flex-shrink: 0; }
.customize-heading { flex-shrink: 0; margin-bottom: 16px; }
.app .customize-heading .screen-title { flex-grow: 1; margin-bottom: 0; }
.app .customize-heading .button { flex-shrink: 0; margin-left: 12px; }
.compact .customize-scroll { height: 400px; }
.equipment-options { align-items: stretch; flex-wrap: wrap; }
.equipment-option { width: 47%; flex-basis: 47%; flex-grow: 0; flex-shrink: 0; min-height: 128px; margin: 0 2% 8px 0; padding: 8px; align-items: center; background-color: #f6eedb; border-color: #b7a88b; }
.equipment-option.equipped { background-color: #e7e0f3; border-color: #645797; }
.equipment-option.equipped:hover { background-color: #f0e9fb; }
.equipment-preview { width: 70px; height: 70px; flex-shrink: 0; }
.equipment-name { max-width: 100%; font-size: 16px; margin-top: 3px; white-space: normal; -unity-text-align: middle-center; }
.equipment-state { font-size: 12px; color: var(--muted); margin-top: 4px; -unity-font-style: normal; }
.equipment-option.equipped .equipment-state { color: #645797; }
.overlay { position: absolute; top: 0; bottom: 0; left: 0; right: 0; background-color: rgba(52,48,75,.38); align-items: center; justify-content: center; opacity: 1; transition-property: opacity; transition-duration: .18s; }
.modal { width: 580px; max-height: 90%; padding: 30px; background-color: #FFF9ED; border-radius: 13px; border-width: 3px; border-color: var(--ink); translate: 0 0; scale: 1 1; transition-property: translate, scale; transition-duration: .25s; }
.overlay.enter { opacity: 0; }
.overlay.enter .modal { translate: 0 16px; scale: 0.97 0.97; }
.modal .title { font-size: 26px; }
.avatar-preview { width: 150px; height: 150px; align-self: center; }
.room-role-details .role-information-identity { flex-direction: row; align-items: center; margin-bottom: 8px; }
.room-role-details .role-information-identity .avatar-preview { width: 104px; height: 104px; flex-shrink: 0; margin-right: 20px; }
.room-role-details .role-information-details { flex-grow: 1; flex-basis: 0; min-width: 0; }
.room-role-details .role-information-details .subtitle { margin: 0 0 6px; white-space: normal; }
.room-role-details .role-information-details .section-title { margin: 0; font-size: 20px; white-space: normal; }
.room-role-instructions { flex-shrink: 0; min-width: 0; margin: 8px 0 16px; padding: 12px 14px; border-radius: 10px; background-color: #EEE8F5; color: #34304B; font-size: 16px; white-space: normal; -unity-text-align: middle-left; }
.rtl .room-role-instructions { -unity-text-align: middle-right; }
.score-row { padding: 10px 8px; border-bottom-width: 1px; border-bottom-color: #e7dcbe; flex-direction: row; align-items: center; justify-content: space-between; }
.score-row .avatar { width: 45px; height: 45px; }
.reveal-liars { justify-content: center; flex-wrap: wrap; }
.reveal-liar { align-items: center; margin: 8px; }
.reveal-liar .avatar-preview { width: 85px; height: 85px; }
.rules { white-space: normal; color: var(--muted); font-size: 12px; margin: 8px 0; }
.toast { position: absolute; bottom: 55px; align-self: center; background-color: #34304B; color: white; padding: 12px 24px; border-radius: 8px; font-size: 14px; white-space: normal; max-width: 800px; }
.motion-enter { transition-property: opacity, translate; transition-timing-function: ease-out; }
.compact .home-layout { max-width: 93%; }
.compact .screen-body { padding: 22px 26px; }
.compact .lobby-panel .lobby-room-list { height: 240px; }
.compact .screen-title { font-size: 30px; margin-bottom: 20px; }
.compact .home-panel .field { min-height: 66px; }
.compact .home-panel .time-form .field { min-height: 42px; margin: 4px 0; }
.compact .home-panel .unity-toggle { min-height: 32px; }
.compact .game-logo { width: 420px; height: 168px; }
.compact .character-stage { height: 330px; }
.compact .lobby-avatar { width: 360px; height: 360px; }

.app.in-game { background-color: #252825; color: #efeadf; padding: 24px 40px; --ink: #282b27; --muted: #a6ab9f; --brand: #e4b66b; --border: #50554d; --mint: #6faf8f; }
.in-game .room-layout { flex-grow: 1; flex-direction: column; min-height: 0; }
.in-game .room-hud { height: 48px; flex-shrink: 0; flex-direction: row; align-items: center; margin-bottom: 16px; }
.in-game .round-label { width: 232px; flex-shrink: 0; flex-direction: row; align-items: center; font-size: 24px; -unity-font-style: bold; }
.in-game .round-caption { font-size: 14px; color: var(--muted); margin-left: 12px; }
.in-game .round-number { -unity-font-style: normal; }
.in-game .phase-bar { flex-grow: 1; min-width: 0; height: 48px; flex-direction: row; align-items: center; justify-content: center; }
.in-game .phase-title { font-size: 24px; -unity-font-style: bold; }
.in-game .phase-detail { font-size: 19px; color: var(--brand); margin-left: 22px; }
.in-game .room-menu { width: 232px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: flex-end; }
.in-game .timer { font-size: 40px; -unity-font-style: normal; color: var(--brand); margin-right: 16px; }
.in-game .timer-urgent { color: #e17f67; }
.in-game .room-menu .button { width: 78px; }
.in-game .workspace { flex-grow: 1; flex-basis: 0; flex-direction: row; min-height: 0; margin-bottom: 16px; }
.in-game .game-sidebar { width: 232px; flex-shrink: 0; flex-direction: column; padding-top: 20px; padding-right: 12px; }
.in-game .center { flex-grow: 1; flex-basis: 0; min-width: 0; min-height: 0; margin: 0 24px; }
.in-game .canvas-frame { flex-grow: 1; min-height: 0; background-color: transparent; border-radius: 0; align-items: center; justify-content: center; overflow: hidden; padding: 0; }
.in-game .drawing-surface { flex-grow: 0; flex-shrink: 0; background-color: #FFFFFF; }
.in-game .context-panel { width: 232px; flex-shrink: 0; flex-direction: column; padding: 20px 8px 0 12px; }
.in-game .secret-bar { flex-direction: column; flex-shrink: 0; }
.in-game .secret-label { font-size: 14px; color: var(--muted); margin-bottom: 12px; }
.in-game .topic { font-size: 26px; -unity-font-style: bold; margin-bottom: 14px; white-space: normal; }
.in-game .role { color: var(--brand); font-size: 14px; border-top-width: 1px; border-top-color: #50554d; padding-top: 14px; margin-bottom: 14px; }
.in-game .word { font-size: 42px; -unity-font-style: bold; margin-bottom: 14px; white-space: normal; }
.in-game .button { height: 48px; min-height: 48px; margin: 0; padding: 8px 12px; border-radius: 4px; border-width: 1px; border-color: #50554d; background-color: #30342f; color: #efeadf; font-size: 18px; -unity-font-style: bold; transition-property: background-color, border-color; transition-duration: .12s; translate: 0 0; scale: 1 1; }
.in-game .button:hover { background-color: #3b4038; border-color: #a6ab9f; translate: 0 0; }
.in-game .button:active { background-color: #454a41; scale: 1 1; translate: 0 0; }
.in-game .button:focus { border-color: #e4b66b; }
.in-game .button:disabled { opacity: .4; }
.in-game .primary, .in-game .tool-selected { background-color: #e4b66b; border-color: #e4b66b; color: #282b27; }
.in-game .primary:hover, .in-game .tool-selected:hover { background-color: #f0c580; border-color: #f0c580; }
.in-game .danger { color: #e17f67; }
.in-game .secret-toggle, .in-game .chat-open { height: 28px; min-height: 28px; padding: 0; border-width: 0; background-color: transparent; color: #a6ab9f; font-size: 14px; -unity-font-style: normal; -unity-text-align: middle-left; }
.in-game .secret-toggle { -unity-text-align: middle-center; }
.in-game .secret-toggle:hover, .in-game .chat-open:hover { background-color: transparent; color: #efeadf; }
.in-game .tools { flex-direction: column; flex-shrink: 0; }
.in-game .tool-row { flex-direction: row; justify-content: space-between; margin-bottom: 16px; }
.in-game .tool-row .button { width: 48%; }
.in-game .palette { width: 208px; max-width: 100%; flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.in-game .palette .swatch { width: 40px; height: 40px; min-height: 40px; flex-shrink: 0; padding: 0; margin: 0 8px 16px 0; border-radius: 20px; border-width: 2px; border-color: transparent; }
.in-game .palette .palette-row-end { margin-right: 0; }
.in-game .palette .swatch.selected, .in-game .palette .swatch:focus { border-color: #efeadf; scale: 1 1; }
.in-game .palette .swatch:hover { border-color: #a6ab9f; }
.in-game .brush-label { font-size: 14px; color: #a6ab9f; margin: 0 0 16px 0; }
.in-game .brush-sizes { flex-direction: row; justify-content: space-between; }
.in-game .brush-sizes .button { width: 28%; height: 44px; min-height: 44px; padding: 0; }
.in-game .brush-sizes .selected { border-color: #e4b66b; }
.in-game .context-info { flex-direction: column; }
.in-game .context-label { font-size: 14px; color: #a6ab9f; margin-bottom: 12px; }
.in-game .context-info .vote-avatar { width: 100px; height: 100px; margin: 20px 0 12px 0; }
.in-game .word-hidden { font-size: 28px; color: #A6AB9F; }
.in-game .context-info .player-name, .in-game .context-name { font-size: 32px; -unity-font-style: bold; margin-bottom: 16px; white-space: normal; }
.in-game .context-title { font-size: 24px; -unity-font-style: bold; margin-bottom: 16px; white-space: normal; }
.in-game .context-detail { color: #a6ab9f; font-size: 15px; white-space: normal; }
.in-game .phase-actions { flex-direction: column; flex-shrink: 0; }
.in-game .phase-actions .button { width: 100%; margin-top: 8px; }
.in-game .phase-actions .rules { font-size: 13px; margin-top: 16px; }
.in-game .chat-history { max-height: 190px; min-height: 0; flex-shrink: 1; margin-bottom: 12px; }
.in-game .chat-entry { margin-bottom: 12px; }
.in-game .chat-name { font-size: 14px; color: #a6ab9f; margin-bottom: 8px; }
.in-game .chat-message { font-size: 17px; color: #efeadf; white-space: normal; }
.in-game .chatbar { display: none; height: 40px; min-height: 40px; flex-shrink: 0; flex-direction: row; align-items: center; }
.in-game .chat-input { flex-grow: 1; min-width: 0; height: 40px; margin-right: 6px; }
.in-game .chat-input .unity-base-text-field__input { min-width: 0; padding: 6px; font-size: 14px; }
.in-game .chatbar .button { width: 56px; height: 40px; min-height: 40px; padding: 4px; font-size: 14px; }
.in-game .players-strip { height: 100px; flex-shrink: 0; flex-direction: row; }
.in-game .player { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; height: 100px; margin: 0 16px 0 0; padding: 16px; background-color: transparent; border-width: 1px; border-color: transparent; border-radius: 3px; transition-property: background-color, border-color; transition-duration: .12s; }
.in-game .player > .row { flex-grow: 1; min-width: 0; }
.in-game .player .grow { min-width: 0; }
.in-game .player .avatar { width: 48px; height: 48px; flex-shrink: 0; margin-right: 12px; }
.in-game .player .player-name { font-size: 19px; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.in-game .player-status, .in-game .player-score, .in-game .player-badge { font-size: 13px; color: #a6ab9f; margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.in-game .player.active-player, .in-game .player.selected-player { background-color: #30342f; border-color: #e4b66b; }
.in-game .active-player .player-status, .in-game .selected-player .player-status { color: #e4b66b; }
.in-game .player.vote-selectable:hover, .in-game .player.vote-selectable:focus { background-color: #30342f; border-color: #e4b66b; }
.in-game .crowded .player { padding: 8px; margin-right: 8px; }
.in-game .crowded .player .avatar { width: 32px; height: 32px; margin-right: 8px; }
.in-game .crowded .player .player-name { font-size: 14px; }
.in-game .crowded .player-status, .in-game .crowded .player-score, .in-game .crowded .player-badge { font-size: 11px; }
.in-game .player.last-player, .in-game .crowded .player.last-player { margin-right: 0; }
.in-game .overlay { background-color: rgba(15,18,15,.72); }
.in-game .modal { padding: 28px; background-color: #30342f; color: #efeadf; border-radius: 4px; border-width: 1px; border-color: #50554d; }
.in-game .modal .title { font-size: 28px; }
.in-game .modal .button { margin-top: 12px; }
.in-game .modal .subtitle { color: #a6ab9f; }
.in-game .modal .field { min-height: 44px; margin: 8px 0; }
.in-game .modal .field > .unity-base-field__label { color: #a6ab9f; }
.in-game .unity-base-text-field__input, .in-game .unity-base-popup-field__input { color: #efeadf; background-color: #252825; border-radius: 4px; border-width: 1px; border-color: #50554d; }
.in-game .unity-base-text-field__input:focus, .in-game .unity-base-popup-field__input:focus { border-color: #e4b66b; }
.in-game .score-row { border-bottom-color: #50554d; }
.in-game .toast { background-color: #30342f; color: #efeadf; border-width: 1px; border-color: #50554d; border-radius: 4px; }
.app.pc-game { background-color: #F8F4E9; color: #34304B; padding: 20px 28px; --ink: #34304B; --muted: #817A87; --brand: #F5B553; --border: #DED5EA; }
.pc-game .room-hud { margin-bottom: 12px; }
.pc-game .round-label, .pc-game .room-menu { width: 184px; }
.pc-game .room-menu { width: 240px; }
.pc-game .phase-detail { color: #78679E; }
.pc-game .timer { color: #78679E; }
.pc-game .timer-urgent { color: #BD594A; }
.game-timer { width: 176px; min-width: 176px; height: 48px; min-height: 48px; flex-shrink: 0; justify-content: center; }
.app .game-timer .timer.timer-value { height: 34px; min-height: 34px; margin: 0; padding: 0; font-size: 34px; color: #645797; -unity-font-style: normal; -unity-text-align: middle-center; }
.timer-track { height: 10px; min-height: 10px; flex-shrink: 0; position: relative; background-color: #DED5EA; border-radius: 6px; overflow: hidden; }
.timer-fill { position: absolute; top: 0; bottom: 0; left: 0; width: 100%; background-color: #78679E; border-radius: 6px; transition-property: width; transition-duration: .1s; transition-timing-function: linear; }
.app .game-timer.timer-urgent .timer-value { color: #BD594A; }
.game-timer.timer-urgent .timer-track { background-color: #F1D8D2; }
.game-timer.timer-urgent .timer-fill { background-color: #BD594A; }
.pc-game .hud-timer { margin-left: 24px; }
.guess-timer-control { width: 112px; min-width: 112px; margin-right: 12px; }
.app .guess-popup .game-timer .timer.timer-value { font-size: 28px; margin: 0; }
.pc-game .pc-game-workspace { margin-bottom: 120px; position: relative; align-items: stretch; }
.pc-game .pc-player-rail { width: 184px; min-width: 184px; flex-shrink: 0; justify-content: center; min-height: 0; }
.pc-game .pc-game-center { margin: 0 20px; }
.pc-game .pc-player-rail .player { width: 100%; flex-grow: 1; flex-basis: 0; min-height: 112px; max-height: 184px; height: auto; margin: 4px 0; padding: 16px 8px 8px; border-width: 1px; border-color: #E3DDD4; border-radius: 16px; background-color: #FFFFFF; }
.pc-game .player > .player-identity { flex-direction: column; align-items: center; justify-content: center; }
.pc-game .player .avatar { width: 128px; height: 128px; flex-shrink: 1; margin: 0 0 4px; }
.pc-game .player .grow { width: 100%; flex-grow: 0; flex-shrink: 0; align-items: center; }
.pc-game .player .player-name { max-width: 100%; height: 18px; flex-shrink: 0; font-size: 14px; -unity-font-style: normal; -unity-text-align: middle-center; color: #34304B; margin: 0; padding: 0; }
.pc-game .player-status { height: 16px; flex-shrink: 0; font-size: 12px; color: #817A87; margin-top: 3px; -unity-text-align: middle-center; }
.pc-game .player .player-summary { width: 100%; height: 16px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: center; margin-top: 3px; }
.pc-game .player .player-score { height: 16px; flex-shrink: 0; margin: 0; padding: 0; font-size: 12px; color: #645797; -unity-font-style: bold; -unity-text-align: middle-center; }
.pc-game .player .player-summary .player-status { min-width: 0; flex-shrink: 1; margin: 0 0 0 6px; }
.pc-game .pc-player-placeholder { visibility: hidden; }
.pc-game .player.active-player, .pc-game .player.selected-player, .pc-game .player.accused-player { background-color: #EEE8F5; border-color: #78679E; }
.pc-game .player.vote-selectable:hover, .pc-game .player.vote-selectable:focus { background-color: #EEE8F5; border-color: #78679E; }
.pc-game .active-player .player-status, .pc-game .selected-player .player-status { color: #78679E; }
.player.disconnected-player { opacity: .55; }
.pc-game .player.preview-player { border-width: 2px; border-color: #537F70; background-color: #EDF5EF; }
.author-preview-guide { width: 100%; font-size: 13px; color: #817A87; -unity-text-align: middle-center; white-space: normal; margin: 0 0 8px; }
.player-host-badge { position: absolute; top: 6px; left: 8px; padding: 2px 6px; border-radius: 6px; background-color: #F9E6BE; color: #736957; font-size: 10px; }
.player-vote-stack { display: none; position: absolute; top: 2px; left: 8px; right: 8px; height: 14px; flex-direction: row; align-items: center; justify-content: center; }
.nomination-player .player-vote-stack.has-votes { display: flex; }
.player-vote-stack .vote-token { width: 14px; min-width: 0; height: 14px; min-height: 0; flex-shrink: 1; margin: 0 1px; color: #645797; background-color: #F9E6BE; border-radius: 3px; }
.nomination-player .player-drawing-order, .pc-game .nomination-player .player-host-badge { visibility: hidden; }
.pc-game .pc-secret-bar { height: auto; min-height: 52px; flex-direction: row; align-items: center; margin-bottom: 8px; padding: 6px 12px; border-width: 1px; border-color: #DED5EA; border-radius: 12px; background-color: #EEE8F5; }
.pc-game .pc-secret-bar .topic { min-width: 0; flex-shrink: 1; margin: 0 12px 0 0; font-size: 16px; white-space: normal; overflow: visible; text-overflow: clip; }
.pc-game .pc-secret-bar .role { min-width: 0; max-width: 18%; flex-shrink: 1; margin: 0 12px 0 0; padding: 0; border-width: 0; font-size: 14px; color: #78679E; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pc-game .pc-secret-bar .word { flex-basis: 0; min-width: 0; margin: 0; font-size: 24px; color: #34304B; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pc-game .pc-secret-bar .secret-toggle { min-width: 64px; height: 32px; min-height: 32px; margin-left: 8px; font-size: 12px; color: #78679E; }
.room-secret-context { flex-direction: row; align-items: center; flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-width: 0; max-width: 55%; margin-right: 12px; }
.room-mode-badges { flex-direction: row; align-items: center; flex-shrink: 1; min-width: 0; max-width: 75%; height: 18px; margin-right: 8px; }
.room-mode-badge { flex-shrink: 1; min-width: 0; height: 18px; margin: 0 4px 0 0; padding: 1px 6px; border-radius: 5px; background-color: #FFFFFF; color: #645797; font-size: 11px; -unity-text-align: middle-center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.room-mode-badge:hover { background-color: #FFF0C7; }
.pc-game .pc-secret-bar .room-secret-context .topic { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0; height: 18px; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.spectator-count { flex-shrink: 0; margin-left: 12px; font-size: 12px; color: #817A87; }
.pc-game .drawing-surface { border-width: 2px; border-color: #34304B; }
.pc-game .pc-game-controls { flex-shrink: 0; margin-top: 8px; }
.pc-game .pc-phase-controls { min-height: 48px; align-items: center; }
.pc-game .context-info { min-width: 0; padding-right: 12px; }
.pc-game .context-info .context-name { margin: 0; font-size: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pc-game .context-info > .muted { font-size: 13px; margin: 0; }
.pc-game .judgment-counts { font-size: 17px; margin: 0 0 3px; color: #645797; -unity-font-style: bold; }
.pc-game .phase-actions { flex-direction: row; align-items: center; max-width: 60%; }
.pc-game .phase-actions .button { width: auto; min-width: 112px; margin: 0 0 0 8px; }
.pc-game .phase-actions .rules { font-size: 12px; margin: 0 0 0 8px; }
.pc-game .tools { flex-direction: row; flex-wrap: wrap; align-items: center; min-height: 48px; margin-bottom: 6px; }
.pc-game .tool-row { width: 196px; min-width: 196px; margin: 0 10px 0 0; align-items: center; }
.pc-game .tool-row .button { width: 62px; height: 40px; min-height: 40px; padding: 4px; font-size: 14px; }
.pc-game .tool-row .clear-own-drawing { width: 116px; height: 48px; min-height: 48px; padding: 3px 4px; white-space: normal; }
.pc-game .palette { width: 316px; min-width: 316px; max-width: none; flex-wrap: nowrap; margin-right: 12px; }
.pc-game .palette .swatch { width: 30px; height: 30px; min-height: 30px; margin: 0 5px 0 0; border-radius: 15px; }
.pc-game .palette .swatch.selected, .pc-game .palette .swatch:focus { border-color: #78679E; }
.in-game .palette .swatch.white-brush { border-color: #D8D1DB; }
.in-game .palette .swatch.white-brush.selected, .in-game .palette .swatch.white-brush:focus { border-color: #78679E; }
.player-drawing-order { position: absolute; top: 5px; right: 7px; width: 24px; height: 24px; padding: 0; border-radius: 12px; background-color: #EEE8F5; color: #78679E; font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; }
.player-drawing-order.drawing-order-current { background-color: #78679E; color: #FFFFFF; }
.drawing-preview-name { position: absolute; top: 8px; left: 8px; margin: 0; padding: 5px 10px; border-radius: 8px; border-width: 1px; border-color: #DED5EA; background-color: #FFFFFF; color: #78679E; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pc-game .tools > .secret-label { display: none; }
.pc-game .brush-sizes { width: 116px; min-width: 116px; }
.pc-game .brush-sizes .button { height: 36px; min-height: 36px; }
.pc-game .brush-sizes .selected { border-color: #78679E; background-color: #EEE8F5; }
.pc-game .room-layout { position: relative; }
.pc-game .pc-room-chat { position: absolute; left: 0; bottom: 0; width: 460px; max-width: 48%; height: 320px; max-height: 65%; min-height: 0; padding: 12px; border-width: 1px; border-color: #DED5EA; border-radius: 12px; background-color: rgba(255,255,255,.82); }
.pc-game .pc-chat-header { height: 28px; min-height: 28px; flex-shrink: 0; margin-bottom: 8px; }
.pc-game .pc-chat-title { min-height: 24px; flex-shrink: 0; margin: 0; padding: 0; font-size: 16px; -unity-font-style: bold; color: #34304B; }
.pc-game .pc-chat-header .chat-open { height: 24px; min-height: 24px; margin: 0; padding: 0; border-width: 0; background-color: transparent; font-size: 13px; color: #78679E; -unity-text-align: middle-left; }
.app.pc-game .pc-chat-close { width: 28px; height: 28px; min-height: 28px; margin: 0; padding: 0; border-width: 1px; border-radius: 7px; }
.pc-game .pc-room-chat.pc-chat-collapsed { width: 360px; height: 112px; padding: 8px 10px; background-color: rgba(255,255,255,.62); }
.pc-game .pc-chat-collapsed .pc-chat-header { display: none; }
.pc-game .pc-chat-collapsed .pc-chat-title, .pc-game .pc-chat-collapsed .pc-chat-close { display: none; }
.pc-game .pc-room-chat.pc-chat-collapsed .chat-history { margin-bottom: 8px; }
.pc-game .pc-chat-collapsed .chat-entry { flex-direction: row; align-items: flex-start; margin-bottom: 4px; }
.pc-game .pc-chat-collapsed .chat-name { width: 88px; max-width: 88px; height: 16px; margin-right: 8px; margin-bottom: 0; }
.pc-game .pc-chat-collapsed .chat-message { flex-grow: 1; flex-basis: 0; height: 16px; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pc-game .pc-chat-collapsed .unity-scroll-view__vertical-scroller { display: none; }
.pc-game .pc-room-chat .chat-history { flex-grow: 1; flex-basis: 0; min-height: 0; max-height: none; margin-bottom: 8px; }
.pc-game .pc-chat-scroll .unity-scroll-view__content-container { width: 100%; min-width: 0; }
.pc-game .chat-entry { width: 100%; min-width: 0; flex-shrink: 0; flex-direction: column; align-items: stretch; margin-bottom: 10px; }
.pc-game .chat-name { max-width: 100%; flex-shrink: 0; margin: 0 0 2px; padding: 0; font-size: 12px; color: #78679E; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pc-game .chat-message { min-width: 0; flex-shrink: 0; margin: 0; padding: 0; font-size: 14px; color: #34304B; white-space: normal; }
.pc-chat-scroll .unity-scroll-view__vertical-scroller { width: 8px; min-width: 8px; margin-left: 8px; background-color: transparent; }
.pc-chat-scroll .unity-scroller__low-button, .pc-chat-scroll .unity-scroller__high-button { display: none; }
.pc-chat-scroll .unity-scroller__slider { margin: 0; padding: 0; }
.pc-chat-scroll .unity-scroller__slider .unity-base-slider__tracker { width: 4px; border-width: 0; background-color: #F2EDF8; border-radius: 4px; }
.pc-chat-scroll .unity-scroller__slider .unity-base-slider__dragger { width: 8px; border-width: 0; background-color: #B7A88B; border-radius: 4px; }
.pc-game .button { border-width: 2px; border-color: #34304B; border-radius: 10px; background-color: #FFF9ED; color: #34304B; font-size: 16px; }
.pc-game .button:hover { background-color: #FFF0C7; border-color: #34304B; }
.pc-game .button:active { background-color: #F2E6CA; }
.pc-game .primary, .pc-game .tool-selected { background-color: #F5B553; border-color: #34304B; color: #34304B; }
.pc-game .primary:hover, .pc-game .tool-selected:hover { background-color: #F8C36F; border-color: #34304B; }
.pc-game .modal { background-color: #FFF9ED; color: #34304B; border-width: 2px; border-color: #34304B; border-radius: 16px; }
.pc-game .modal .subtitle { color: #817A87; }
.pc-game .unity-base-text-field__input, .pc-game .unity-base-popup-field__input { color: #34304B; background-color: #FFFFFF; border-color: #DED5EA; }
.pc-game .toast { background-color: #34304B; color: #FFFFFF; border-radius: 10px; }
.judgment-actions { align-items: stretch; }
.judgment-actions .button { flex-basis: 0; flex-grow: 1; }
.judgment-panel { width: 100%; max-width: 760px; align-self: center; flex-shrink: 0; align-items: stretch; margin-bottom: 8px; padding: 12px 16px; border-width: 1px; border-color: #DED5EA; border-radius: 14px; background-color: #EEE8F5; }
.judgment-panel .judgment-counts { font-size: 18px; margin: 0; color: #645797; -unity-font-style: bold; -unity-text-align: middle-center; }
.judgment-panel .judgment-progress { font-size: 13px; color: #817A87; margin: 4px 0 12px; -unity-text-align: middle-center; }
.app .judgment-panel .judgment-actions .button { width: auto; min-width: 0; height: 72px; min-height: 72px; margin: 0 12px 0 0; padding: 12px 16px; border-radius: 12px; border-width: 2px 2px 4px; border-color: #34304B; font-size: 24px; color: #34304B; }
.app .judgment-panel .judgment-actions .judgment-approve { background-color: #F5B553; }
.app .judgment-panel .judgment-actions .judgment-reject { margin-right: 0; background-color: #FFF9ED; }
.app .judgment-panel .judgment-actions .judgment-approve:hover { background-color: #FFC975; }
.app .judgment-panel .judgment-actions .judgment-reject:hover { background-color: #FFFFFF; }
.judgment-state { margin-top: 8px; color: #645797; font-size: 14px; -unity-text-align: middle-center; }
.nomination-panel { padding: 16px; align-items: center; }
.nomination-prompt { max-width: 100%; margin: 0 0 12px; padding: 0; font-size: 26px; color: #34304B; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.nomination-target { max-width: 100%; margin: 0 0 12px; color: #645797; font-size: 20px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.nomination-current { max-width: 100%; margin: 0 0 6px; color: #645797; font-size: 14px; -unity-text-align: middle-center; white-space: normal; }
.app .nomination-panel .nomination-submit { width: 360px; max-width: 100%; height: 56px; min-height: 56px; margin: 0; padding: 8px 16px; font-size: 20px; border-radius: 12px; }
.nomination-actions { width: 680px; max-width: 100%; align-items: stretch; }
.app .nomination-actions .button { width: auto; flex-basis: 0; flex-grow: 1; min-width: 0; min-height: 56px; margin: 0; font-size: 20px; white-space: normal; }
.app .nomination-actions .nomination-none { margin-right: 12px; }
.app .nomination-none.create-mode-selected { background-color: #E9E4F3; border-color: #78679E; }
.nomination-progress { margin-top: 8px; font-size: 13px; color: #817A87; -unity-text-align: middle-center; }
.pc-phase-controls.phase-controls-empty { display: none; }
.app .guess-popup-overlay { justify-content: center; align-items: center; }
.app .modal.utility-popup.guess-popup { width: 540px; max-width: 92%; height: auto; max-height: 90%; padding: 24px; border-radius: 16px; }
.app .guess-popup .guess-timer { font-size: 24px; color: #78679E; margin-right: 12px; }
.app .guess-popup .guess-timer.timer-urgent { color: #BD594A; }
.app .guess-popup .guess-input { width: 100%; height: 64px; min-height: 64px; margin: 0 0 16px; }
.app .guess-popup .guess-input .unity-base-text-field__input { font-size: 22px; min-height: 64px; padding: 12px 16px; }
.app .utility-popup.guess-popup .guess-submit { width: 100%; height: 64px; min-height: 64px; font-size: 22px; }
