      - "\u0411\u0440\u0435\u0445\u0443\u043D \u0431\u0443\u0432 {0} \xB7 \u0448\u043F\u0438\u0433\u0443\u043D
        \u0431\u0443\u0432 {1}."
      - "Yalanc\u0131 {0}, casus ise {1} idi."
      - "\u0643\u0627\u0646 \u0627\u0644\u0643\u0627\u0630\u0628 {0} \xB7 \u0648\u0643\u0627\u0646
        \u0627\u0644\u062C\u0627\u0633\u0648\u0633 {1}."
      - "\u05D4\u05E9\u05E7\u05E8\u05DF \u05D4\u05D9\u05D4 {0} \xB7 \u05D4\u05DE\u05E8\u05D2\u05DC
