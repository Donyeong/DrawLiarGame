    - Term: UI/67CpIOyYteyFmOydhCDsoIDsnqXtlZjsp4Ag66q77ZaI7Iq164uI64ukLiDri6Tsi5wg7Iuc64-E7ZWY7IS47JqULg
      TermType: 0
      Description: "\uBC29 \uC635\uC158\uC744 \uC800\uC7A5\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.
        \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
      Languages:
      - "\uBC29 \uC635\uC158\uC744 \uC800\uC7A5\uD558\uC9C0 \uBABB\uD588\uC2B5\uB2C8\uB2E4.
        \uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC138\uC694."
      - Could not save room options. Please try again.
      - "\u30EB\u30FC\u30E0\u8A2D\u5B9A\u3092\u4FDD\u5B58\u3067\u304D\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u3082\u3046\u4E00\u5EA6\u304A\u8A66\u3057\u304F\u3060\u3055\u3044\u3002"
      - "\u65E0\u6CD5\u4FDD\u5B58\u623F\u95F4\u9009\u9879\uFF0C\u8BF7\u91CD\u8BD5\u3002"
      - Die Raumoptionen konnten nicht gespeichert werden. Bitte versuche es erneut.
      - "Impossible d'enregistrer les options du salon. R\xE9essayez."
      - "No se pudieron guardar las opciones de la sala. Int\xE9ntalo de nuevo."
      - "No se pudieron guardar las opciones de habitaci\xF3n. Por favor int\xE9ntalo
        de nuevo."
      - "N\xE3o foi poss\xEDvel guardar as op\xE7\xF5es de quarto. Por favor, tente
        novamente."
      - Impossibile salvare le opzioni della camera. Per favore riprova.
      - Kan kameropties niet opslaan. Probeer het opnieuw.
      - "Kunne ikke gemme v\xE6relsesindstillinger. Pr\xF8v venligst igen."
      - "Kunne ikke lagre romalternativer. Vennligst pr\xF8v igjen."
      - "Det gick inte att spara rumsalternativ. F\xF6rs\xF6k igen."
      - "Huonevaihtoehtoja ei voitu tallentaa. Yrit\xE4 uudelleen."
      - "Nie uda\u0142o si\u0119 zapisa\u0107 opcji pokoju. Spr\xF3buj ponownie."
      - "Mo\u017Enosti m\xEDstnosti se nepoda\u0159ilo ulo\u017Eit. Zkuste to pros\xEDm
        znovu."
      - "Mo\u017Enosti miestnosti sa nepodarilo ulo\u017Ei\u0165. Sk\xFAste to znova."
      - "Nem siker\xFClt menteni a szobalehet\u0151s\xE9geket. K\xE9rj\xFCk, pr\xF3b\xE1lja
        \xFAjra."
      - "Op\u021Biunile camerei nu au putut fi salvate. V\u0103 rug\u0103m s\u0103
        \xEEncerca\u021Bi din nou."
      - "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
        \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u043D\u043E\u043C\u0435\u0440\u043E\u0432.
        \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
        \u0435\u0449\u0435 \u0440\u0430\u0437."
      - "\u041D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438
        \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u0438 \u043A\u0456\u043C\u043D\u0430\u0442\u0438.
        \u0421\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."
      - "Oda se\xE7enekleri kaydedilemedi. L\xFCtfen tekrar deneyin."
      - "\u062A\u0639\u0630\u0631 \u062D\u0641\u0638 \u062E\u064A\u0627\u0631\u0627\u062A
        \u0627\u0644\u063A\u0631\u0641\u0629. \u064A\u0631\u062C\u0649 \u0627\u0644\u0645\u062D\u0627\u0648\u0644\u0629
        \u0645\u062C\u062F\u062F\u064B\u0627."
      - "\u05DC\u05D0 \u05E0\u05D9\u05EA\u05DF \u05DC\u05E9\u05DE\u05D5\u05E8 \u05D0\u05EA
        \u05D0\u05E4\u05E9\u05E8\u05D5\u05D9\u05D5\u05EA \u05D4\u05D7\u05D3\u05E8.
        \u05D0\u05E0\u05D0 \u05E0\u05E1\u05D4 \u05E9\u05D5\u05D1."
      - "\u0930\u0942\u092E \u0915\u0947 \u0935\u093F\u0915\u0932\u094D\u092A \u0938\u0947\u0935
        \u0928\u0939\u0940\u0902 \u0939\u094B \u0938\u0915\u0947\u0964 \u0915\u0943\u092A\u092F\u093E
        \u092B\u093F\u0930 \u0938\u0947 \u0915\u094B\u0936\u093F\u0936 \u0915\u0930\u0947\u0902\u0964"
      - Opsi ruang tidak dapat disimpan. Silakan coba lagi.
      - "\u0E44\u0E21\u0E48\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E1A\u0E31\u0E19\u0E17\u0E36\u0E01\u0E15\u0E31\u0E27\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E2B\u0E49\u0E2D\u0E07\u0E44\u0E14\u0E49
