    - Term: UI/7KO87KCcIOydtOumhOydtCDsnbTrr7gg7IKs7JqpIOykkeyeheuLiOuLpC4g64uk66W4IOydtOumhOydhCDsnoXroKXtlZjshLjsmpQu
      TermType: 0
      Description: "\uC8FC\uC81C \uC774\uB984\uC774 \uC774\uBBF8 \uC0AC\uC6A9 \uC911\uC785\uB2C8\uB2E4.
        \uB2E4\uB978 \uC774\uB984\uC744 \uC785\uB825\uD558\uC138\uC694."
      Languages:
      - "\uC8FC\uC81C \uC774\uB984\uC774 \uC774\uBBF8 \uC0AC\uC6A9 \uC911\uC785\uB2C8\uB2E4.
        \uB2E4\uB978 \uC774\uB984\uC744 \uC785\uB825\uD558\uC138\uC694."
      - This topic name is already in use. Enter a different name.
      - "\u3053\u306E\u30C6\u30FC\u30DE\u540D\u306F\u4F7F\u7528\u4E2D\u3067\u3059\u3002\u5225\u306E\u540D\u524D\u3092\u5165\u529B\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
      - "\u8BE5\u4E3B\u9898\u540D\u79F0\u5DF2\u88AB\u4F7F\u7528\uFF0C\u8BF7\u8F93\u5165\u5176\u4ED6\u540D\u79F0\u3002"
      - Dieser Themenname wird bereits verwendet. Gib einen anderen ein.
      - "Ce nom est d\xE9j\xE0 utilis\xE9. Saisissez un autre nom."
      - "Este nombre ya est\xE1 en uso. Escribe otro."
      - "El nombre de este tema ya est\xE1 en uso. Introduzca un nombre diferente."
      - "Este nome de t\xF3pico j\xE1 est\xE1 em utiliza\xE7\xE3o. Introduza um nome
        diferente."
      - "Questo nome di argomento \xE8 gi\xE0 in uso. Inserisci un nome diverso."
      - Deze onderwerpnaam is al in gebruik. Voer een andere naam in.
      - Dette emnenavn er allerede i brug. Indtast et andet navn.
      - Dette emnenavnet er allerede i bruk. Skriv inn et annet navn.
      - "Detta \xE4mnesnamn anv\xE4nds redan. Ange ett annat namn."
      - "T\xE4m\xE4 aiheen nimi on jo k\xE4yt\xF6ss\xE4. Anna eri nimi."
      - "Ta nazwa tematu jest ju\u017C u\u017Cywana. Wpisz inn\u0105 nazw\u0119."
      - "Tento n\xE1zev t\xE9matu se ji\u017E pou\u017E\xEDv\xE1. Zadejte jin\xFD
        n\xE1zev."
      - "Tento n\xE1zov t\xE9my sa u\u017E pou\u017E\xEDva. Zadajte in\xFD n\xE1zov."
      - "Ez a t\xE9man\xE9v m\xE1r haszn\xE1latban van. Adjon meg egy m\xE1sik nevet."
      - "Acest nume de subiect este deja utilizat. Introduce\u021Bi un alt nume."
      - "\u042D\u0442\u043E \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0442\u0435\u043C\u044B
        \u0443\u0436\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F.
        \u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u043E\u0435
        \u0438\u043C\u044F."
      - "\u0426\u044F \u043D\u0430\u0437\u0432\u0430 \u0442\u0435\u043C\u0438 \u0432\u0436\u0435
        \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u044C\u0441\u044F.
        \u0412\u0432\u0435\u0434\u0456\u0442\u044C \u0456\u043D\u0448\u0435 \u0456\u043C'\u044F."
      - "Bu konu ad\u0131 zaten kullan\u0131l\u0131yor. Farkl\u0131 bir ad girin."
      - "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0636\u0648\u0639 \u0645\u0633\u062A\u062E\u062F\u0645
        \u0628\u0627\u0644\u0641\u0639\u0644. \u0623\u062F\u062E\u0644 \u0627\u0633\u0645\u064B\u0627
        \u0622\u062E\u0631."
      - "\u05E9\u05DD \u05D4\u05E0\u05D5\u05E9\u05D0 \u05D4\u05D6\u05D4 \u05DB\u05D1\u05E8
        \u05D1\u05E9\u05D9\u05DE\u05D5\u05E9. \u05D4\u05D6\u05DF \u05E9\u05DD \u05D0\u05D7\u05E8."
      - "\u092F\u0939 \u0935\u093F\u0937\u092F \u0928\u093E\u092E \u092A\u0939\u0932\u0947
        \u0938\u0947 \u0909\u092A\u092F\u094B\u0917 \u092E\u0947\u0902 \u0939\u0948\u0964
        \u0926\u0942\u0938\u0930\u093E \u0928\u093E\u092E \u0932\u093F\u0916\u0947\u0902\u0964"
      - Nama topik ini sudah digunakan. Masukkan nama lain.
      - "\u0E0A\u0E37\u0E48\u0E2D\u0E2B\u0E31\u0E27\u0E02\u0E49\u0E2D\u0E19\u0E35\u0E49\u0E21\u0E35\u0E01\u0E32\u0E23\u0E43\u0E0A\u0E49\u0E07\u0E32\u0E19\u0E41\u0E25\u0E49\u0E27
        \u0E1B\u0E49\u0E2D\u0E19\u0E0A\u0E37\u0E48\u0E2D\u0E2D\u0E37\u0E48\u0E19"
      - "T\xEAn ch\u1EE7 \u0111\u1EC1 n\xE0y \u0111\xE3 \u0111\u01B0\u1EE3c s\u1EED
        d\u1EE5ng. Nh\u1EADp m\u1ED9t t\xEAn kh\xE1c."
