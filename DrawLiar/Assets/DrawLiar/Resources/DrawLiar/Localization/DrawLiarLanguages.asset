      - "\u9A57\u8B49\u8ACB\u6C42\u7121\u6548\uFF0C\u8ACB\u8FD4\u56DE\u904A\u6232\u91CD\u8A66\u3002"
      - "\u8A8D\u8A3C\u30EA\u30AF\u30A8\u30B9\u30C8\u304C\u6B63\u3057\u304F\u3042\u308A\u307E\u305B\u3093\u3002\u30B2\u30FC\u30E0\u306B\u623B\u3063\u3066\u3082\u3046\u4E00\u5EA6\u304A\u8A66\u3057\u304F\u3060\u3055\u3044\u3002"
