    - Term: UI/7LGE7YyF7J2EIO2PrOq3vO2VnCDqtazrpoQg66qo7JaR7Jy866GcIOq-uOupsOyalC4
      TermType: 0
      Description: "\uCC44\uD305\uC744 \uD3EC\uADFC\uD55C \uAD6C\uB984 \uBAA8\uC591\uC73C\uB85C
