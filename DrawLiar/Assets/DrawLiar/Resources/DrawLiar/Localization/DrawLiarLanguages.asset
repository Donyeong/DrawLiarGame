      - "\u0428\u043F\u0438\u043E\u043D\u0441\u043A\u0438\u0439 \u0440\u0435\u0436\u0438\u043C
        \xB7 \u0426\u0435\u043B\u0435\u0432\u044B\u0435 \u0442\u043E\u0447\u043A\u0438:
        {0} \xB7 \u041F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
        \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0440\u0430\u0443\u043D\u0434\u043E\u0432:
        \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u043E"
      - "\u0428\u043F\u0438\u0433\u0443\u043D\u0441\u044C\u043A\u0438\u0439 \u0440\u0435\u0436\u0438\u043C
        \xB7 \u0426\u0456\u043B\u044C\u043E\u0432\u0456 \u0431\u0430\u043B\u0438:
        {0} \xB7 \u041F\u0440\u0438\u0454\u0434\u043D\u0430\u043D\u043D\u044F \u043F\u0456\u0434
        \u0447\u0430\u0441 \u0440\u0430\u0443\u043D\u0434\u0456\u0432: \u0432\u0438\u043C\u043A\u043D\u0435\u043D\u043E"
      - "Casus modu \xB7 Hedef noktalar: {0} \xB7 Turlar s\u0131ras\u0131nda kat\u0131lma:
        devre d\u0131\u015F\u0131"
      - "\u0648\u0636\u0639 \u0627\u0644\u062C\u0627\u0633\u0648\u0633 \xB7 \u0627\u0644\u0647\u062F\u0641
        {0} \u0646\u0642\u0627\u0637 \xB7 \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645
        \u0623\u062B\u0646\u0627\u0621 \u0627\u0644\u062C\u0648\u0644\u0629: \u0645\u0645\u0646\u0648\u0639"
      - "\u05DE\u05E6\u05D1 \u05E8\u05D9\u05D2\u05D5\u05DC \xB7 \u05E0\u05E7\u05D5\u05D3\u05D5\u05EA
        \u05D9\u05E2\u05D3: {0} \xB7 \u05D4\u05E6\u05D8\u05E8\u05E4\u05D5\u05EA \u05D1\u05DE\u05D4\u05DC\u05DA
        \u05E1\u05D9\u05D1\u05D5\u05D1\u05D9\u05DD: \u05DE\u05D5\u05E9\u05D1\u05EA\u05EA"
