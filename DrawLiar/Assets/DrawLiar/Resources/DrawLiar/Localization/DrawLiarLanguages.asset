    - Term: UI/64uJ64Sk7J6E7J2AIDJ-MTbsnpDsnZgg6riA7J6QLCDsiKvsnpAsIOqzteuwsSwg67CR7KSE66GcIOyeheugpe2VmOyEuOyalC4
      TermType: 0
      Description: "\uB2C9\uB124\uC784\uC740 2~16\uC790\uC758 \uAE00\uC790, \uC22B\uC790,
        \uACF5\uBC31, \uBC11\uC904\uB85C \uC785\uB825\uD558\uC138\uC694."
      Languages:
      - "\uB2C9\uB124\uC784\uC740 2~16\uC790\uC758 \uAE00\uC790, \uC22B\uC790, \uACF5\uBC31,
        \uBC11\uC904\uB85C \uC785\uB825\uD558\uC138\uC694."
      - "Use 2\u201316 characters: letters, numbers, spaces, or underscores."
      - "\u6635\u79F0\u987B\u4E3A2\u201316\u4E2A\u5B57\u7B26\uFF0C\u53EF\u4F7F\u7528\u6587\u5B57\u3001\u6570\u5B57\u3001\u7A7A\u683C\u548C\u4E0B\u5212\u7EBF\u3002"
      - "\u66B1\u7A31\u9808\u70BA 2\u201316 \u500B\u5B57\u5143\uFF0C\u53EF\u4F7F\u7528\u6587\u5B57\u3001\u6578\u5B57\u3001\u7A7A\u683C\u8207\u5E95\u7DDA\u3002"
      - "\u30CB\u30C3\u30AF\u30CD\u30FC\u30E0\u306F\u6587\u5B57\u30FB\u6570\u5B57\u30FB\u30B9\u30DA\u30FC\u30B9\u30FB\u30A2\u30F3\u30C0\u30FC\u30B9\u30B3\u30A2\u30672\u301C16\u6587\u5B57\u306B\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
      - "El apodo debe tener entre 2 y 16 caracteres: letras, n\xFAmeros, espacios
        o guiones bajos."
      - "O apelido deve ter de 2 a 16 caracteres: letras, n\xFAmeros, espa\xE7os
        ou sublinhados."
      - "Le pseudo doit contenir 2 \xE0 16 caract\xE8res : lettres, chiffres, espaces
        ou traits de soulignement."
      - 'Der Spitzname muss 2 bis 16 Zeichen enthalten: Buchstaben, Zahlen, Leerzeichen
        oder Unterstriche.'
      - "Nama panggilan harus terdiri dari 2\u201316 karakter: huruf, angka, spasi,
        atau garis bawah."
      - "\u0909\u092A\u0928\u093E\u092E \u092E\u0947\u0902 2\u201316 \u0935\u0930\u094D\u0923
        \u0939\u094B\u0928\u0947 \u091A\u093E\u0939\u093F\u090F: \u0905\u0915\u094D\u0937\u0930,
        \u0905\u0902\u0915, \u0938\u094D\u092A\u0947\u0938 \u092F\u093E \u0905\u0902\u0921\u0930\u0938\u094D\u0915\u094B\u0930\u0964"
      - "\u064A\u062C\u0628 \u0623\u0646 \u064A\u062A\u0643\u0648\u0651\u0646 \u0627\u0644\u0627\u0633\u0645
        \u0627\u0644\u0645\u0633\u062A\u0639\u0627\u0631 \u0645\u0646 2 \u0625\u0644\u0649
        16 \u0645\u062D\u0631\u0641\u064B\u0627: \u062D\u0631\u0648\u0641 \u0623\u0648
        \u0623\u0631\u0642\u0627\u0645 \u0623\u0648 \u0645\u0633\u0627\u0641\u0627\u062A
        \u0623\u0648 \u0634\u0631\u0637\u0627\u062A \u0633\u0641\u0644\u064A\u0629."
      Flags: 000000000000000000000000
      Languages_Touch: []
