        \u0627\u0644\u064A\u0648\u0645 \u0628\u0627\u0644\u0641\u0639\u0644."
      - "\u05DB\u05D1\u05E8 \u05EA\u05D1\u05E2\u05EA \u05D0\u05EA \u05D0\u05D1\u05E0\u05D9
        \u05D4\u05D7\u05DF \u05D4\u05D7\u05D9\u05E0\u05DE\u05D9\u05D5\u05EA \u05E9\u05DC
        \u05D4\u05D9\u05D5\u05DD."
      - "\u0906\u092A \u0906\u091C \u0915\u0947 \u092E\u0941\u092B\u093C\u094D\u0924
        \u0930\u0924\u094D\u0928 \u092A\u0939\u0932\u0947 \u0939\u0940 \u092A\u094D\u0930\u093E\u092A\u094D\u0924
