    - Term: UI/65287J207Ja064qUIOygnOyLnOyWtOulvCDrqqjrpoXri4jri6QuIOq3uOumvOydhCDrs7Tqs6Ag65287J207Ja066W8IOywvuycvOyEuOyalC4K7LWc7IaMIHswfeuqhQ
      TermType: 0
      Description: "\uB77C\uC774\uC5B4\uB294 \uC81C\uC2DC\uC5B4\uB97C \uBAA8\uB985\uB2C8\uB2E4.
        \uADF8\uB9BC\uC744 \uBCF4\uACE0 \uB77C\uC774\uC5B4\uB97C \uCC3E\uC73C\uC138\uC694.\n\uCD5C\uC18C
        {0}\uBA85"
      Languages:
      - "\uB77C\uC774\uC5B4\uB294 \uC81C\uC2DC\uC5B4\uB97C \uBAA8\uB985\uB2C8\uB2E4.
        \uADF8\uB9BC\uC744 \uBCF4\uACE0 \uB77C\uC774\uC5B4\uB97C \uCC3E\uC73C\uC138\uC694.\n\uCD5C\uC18C
        {0}\uBA85"
      - 'Liars do not know the word. Find them through their drawings.

        Minimum:
        {0} players'
      - "\u8BF4\u8C0E\u8005\u4E0D\u77E5\u9053\u63D0\u793A\u8BCD\u3002\u901A\u8FC7\u7ED8\u753B\u627E\u51FA\u8BF4\u8C0E\u8005\u3002\n\u81F3\u5C11
        {0} \u4EBA"
      - "\u8AAA\u8B0A\u8005\u4E0D\u77E5\u9053\u63D0\u793A\u8A5E\u3002\u900F\u904E\u7E6A\u756B\u627E\u51FA\u8AAA\u8B0A\u8005\u3002\n\u81F3\u5C11
        {0} \u4EBA"
      - "\u30E9\u30A4\u30A2\u30FC\u306F\u304A\u984C\u306E\u5358\u8A9E\u3092\u77E5\u308A\u307E\u305B\u3093\u3002\u7D75\u3092\u898B\u3066\u898B\u3064\u3051\u307E\u3057\u3087\u3046\u3002\n\u6700\u4F4E
        {0} \u4EBA"
      - "Los mentirosos no conocen la palabra. Encu\xE9ntralos por sus dibujos.\nM\xEDnimo:
        {0} jugadores"
      - "Os mentirosos n\xE3o sabem a palavra. Encontre-os pelos desenhos.\nM\xEDnimo:
        {0} jogadores"
      - "Les menteurs ne connaissent pas le mot. Rep\xE9rez-les gr\xE2ce aux dessins.\nMinimum
        : {0} joueurs"
      - "L\xFCgner kennen das Wort nicht. Finde sie anhand der Zeichnungen.\nMindestens
        {0} Spieler"
      - 'Pembohong tidak tahu kata yang diberikan. Temukan mereka lewat gambar.

        Minimal:
        {0} pemain'
      - "\u091D\u0942\u0920\u094B\u0902 \u0915\u094B \u0926\u093F\u092F\u093E \u0917\u092F\u093E
        \u0936\u092C\u094D\u0926 \u0928\u0939\u0940\u0902 \u092A\u0924\u093E\u0964
        \u091A\u093F\u0924\u094D\u0930 \u0926\u0947\u0916\u0915\u0930 \u0909\u0928\u094D\u0939\u0947\u0902
        \u092A\u0939\u091A\u093E\u0928\u0947\u0902\u0964\n\u0915\u092E \u0938\u0947
        \u0915\u092E {0} \u0916\u093F\u0932\u093E\u0921\u093C\u0940"
      - "\u0627\u0644\u0643\u0627\u0630\u0628\u0648\u0646 \u0644\u0627 \u064A\u0639\u0631\u0641\u0648\u0646
        \u0627\u0644\u0643\u0644\u0645\u0629. \u0627\u0643\u062A\u0634\u0641\u0647\u0645
        \u0645\u0646 \u0631\u0633\u0648\u0645\u0627\u062A\u0647\u0645.\n\u0627\u0644\u062D\u062F
        \u0627\u0644\u0623\u062F\u0646\u0649: {0} \u0644\u0627\u0639\u0628\u064A\u0646"
      Flags: 000000000000000000000000
      Languages_Touch: []
