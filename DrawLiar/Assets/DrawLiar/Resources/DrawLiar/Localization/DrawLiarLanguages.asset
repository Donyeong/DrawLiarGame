    - Term: UI/6rSR6rOgIOuztOyDgeydtCDrp4zro4zrkJjsl4jsirXri4jri6QuIOuLpOyLnCDsi5zrj4TtlbQg7KO87IS47JqULg
      TermType: 0
      Description: "\uAD11\uACE0 \uBCF4\uC0C1\uC774 \uB9CC\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
