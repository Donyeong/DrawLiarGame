    - Term: UI/7LGE7YyF7JeQIOyXsOqysO2VmOqzoCDsnojsirXri4jri6TigKY
      TermType: 0
      Description: "\uCC44\uD305\uC5D0 \uC5F0\uACB0\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4\u2026"
      Languages:
      - "\uCC44\uD305\uC5D0 \uC5F0\uACB0\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4\u2026"
      - "Connecting to chat\u2026"
      - "\u30C1\u30E3\u30C3\u30C8\u306B\u63A5\u7D9A\u4E2D\u2026"
      - "\u6B63\u5728\u8FDE\u63A5\u804A\u5929\u2026"
