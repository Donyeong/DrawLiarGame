    - Term: UI/7LqQ66at7YSw7JeQIOuniOyasOyKpOulvCDsmKzroKQg6re4IOyCrOuejOydmCDqt7jrprzsnYQg7ZmV7J247ZWY7IS47JqULg
      TermType: 0
      Description: "\uCE90\uB9AD\uD130\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB824
        \uADF8 \uC0AC\uB78C\uC758 \uADF8\uB9BC\uC744 \uD655\uC778\uD558\uC138\uC694."
      Languages:
      - "\uCE90\uB9AD\uD130\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB824 \uADF8 \uC0AC\uB78C\uC758
        \uADF8\uB9BC\uC744 \uD655\uC778\uD558\uC138\uC694."
      - Hover over a character to view their drawing.
      - "\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u306B\u30DE\u30A6\u30B9\u3092\u91CD\u306D\u308B\u3068\u3001\u305D\u306E\u4EBA\u306E\u7D75\u3092\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002"
      - "\u5C06\u9F20\u6807\u60AC\u505C\u5728\u89D2\u8272\u4E0A\u5373\u53EF\u67E5\u770B\u5176\u7ED8\u753B\u3002"
      - "Fahre mit der Maus \xFCber eine Figur, um ihre Zeichnung zu sehen."
      - Survolez un personnage pour voir son dessin.
      - Pasa el cursor sobre un personaje para ver su dibujo.
      - Pase el cursor sobre un personaje para ver su dibujo.
      - Passe o rato sobre um personagem para ver o seu desenho.
      - Passa il mouse sopra un personaggio per visualizzarne il disegno.
      - Beweeg over een personage om zijn tekening te bekijken.
      - "Hold mark\xF8ren over en karakter for at se deres tegning."
      - "Hold mark\xF8ren over en karakter for \xE5 se tegningen deres."
      - "H\xE5ll muspekaren \xF6ver en karakt\xE4r f\xF6r att se deras teckning."
      - "Vie hiiri hahmon p\xE4\xE4lle n\xE4hd\xE4ksesi h\xE4nen piirroksensa."
      - "Najed\u017A kursorem na posta\u0107, aby zobaczy\u0107 jej rysunek."
      - "Um\xEDst\u011Bn\xEDm ukazatele my\u0161i na postavu zobraz\xEDte jej\xED
        kresbu."
      - "Umiestnen\xEDm kurzora my\u0161i na postavu zobraz\xEDte jej kresbu."
      - "Vigye az eg\xE9rmutat\xF3t egy karakter f\xF6l\xE9 a rajz\xE1nak megtekint\xE9s\xE9hez."
      - "Plasa\u021Bi cursorul peste un personaj pentru a-\u0219i vedea desenul."
      - "\u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u043A\u0443\u0440\u0441\u043E\u0440
        \u043D\u0430 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430, \u0447\u0442\u043E\u0431\u044B
        \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0435\u0433\u043E
        \u0440\u0438\u0441\u0443\u043D\u043E\u043A."
      - "\u041D\u0430\u0432\u0435\u0434\u0456\u0442\u044C \u043A\u0443\u0440\u0441\u043E\u0440
        \u043D\u0430 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430, \u0449\u043E\u0431
        \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u0439\u043E\u0433\u043E
        \u043C\u0430\u043B\u044E\u043D\u043E\u043A."
      - "\xC7izimini g\xF6r\xFCnt\xFClemek i\xE7in bir karakterin \xFCzerine gelin."
      - "\u0645\u0631\u0651\u0631 \u0645\u0624\u0634\u0631 \u0627\u0644\u0641\u0623\u0631\u0629
        \u0641\u0648\u0642 \u0627\u0644\u0634\u062E\u0635\u064A\u0629 \u0644\u0631\u0624\u064A\u0629
        \u0631\u0633\u0645\u0647\u0627."
      - "\u05E8\u05D7\u05E3 \u05DE\u05E2\u05DC \u05D3\u05DE\u05D5\u05EA \u05DB\u05D3\u05D9
        \u05DC\u05E8\u05D0\u05D5\u05EA \u05D0\u05EA \u05D4\u05E6\u05D9\u05D5\u05E8
        \u05E9\u05DC\u05D4."
      - "\u0915\u093F\u0938\u0940 \u092A\u093E\u0924\u094D\u0930 \u0915\u093E \u091A\u093F\u0924\u094D\u0930
        \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F \u0909\u0938
        \u092A\u0930 \u092E\u093E\u0909\u0938 \u0932\u0947 \u091C\u093E\u090F\u0901\u0964"
      - Arahkan kursor ke karakter untuk melihat gambarnya.
      - "\u0E27\u0E32\u0E07\u0E40\u0E21\u0E32\u0E2A\u0E4C\u0E40\u0E2B\u0E19\u0E37\u0E2D\u0E15\u0E31\u0E27\u0E25\u0E30\u0E04\u0E23\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E14\u0E39\u0E20\u0E32\u0E1E\u0E27\u0E32\u0E14"
      - "Di chu\u1ED9t qua m\u1ED9t nh\xE2n v\u1EADt \u0111\u1EC3 xem b\u1EA3n v\u1EBD
        c\u1EE7a h\u1ECD."
