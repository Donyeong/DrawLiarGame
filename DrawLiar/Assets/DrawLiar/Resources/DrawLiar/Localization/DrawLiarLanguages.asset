        \u043D\u0435\u043E\u043D\u043E\u0432\u044B\u043C\u0438 \u043B\u0438\u043D\u0438\u044F\u043C\u0438."
      - "\u041E\u0442\u043E\u0447\u0456\u0442\u044C \u0441\u0432\u043E\u0433\u043E
        \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430 \u044F\u0441\u043A\u0440\u0430\u0432\u0438\u043C\u0438
