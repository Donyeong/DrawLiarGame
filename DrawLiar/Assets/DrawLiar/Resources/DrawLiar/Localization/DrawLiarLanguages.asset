    - Term: UI/6rCB7J6QIOy6lOuyhOyKpOyXkCDssKjroYDroZwg6re466a964uI64ukLiDthqDroaAg65WMIOywuOqwgOyekOydmCDqt7jrprzsnYQg67mE6rWQ7ZWY7IS47JqULgrstZzshowgezB966qF
      TermType: 0
      Description: "\uAC01\uC790 \uCE94\uBC84\uC2A4\uC5D0 \uCC28\uB840\uB85C \uADF8\uB9BD\uB2C8\uB2E4.
        \uD1A0\uB860 \uB54C \uCC38\uAC00\uC790\uC758 \uADF8\uB9BC\uC744 \uBE44\uAD50\uD558\uC138\uC694.\n\uCD5C\uC18C
        {0}\uBA85"
      Languages:
      - "\uAC01\uC790 \uCE94\uBC84\uC2A4\uC5D0 \uCC28\uB840\uB85C \uADF8\uB9BD\uB2C8\uB2E4.
        \uD1A0\uB860 \uB54C \uCC38\uAC00\uC790\uC758 \uADF8\uB9BC\uC744 \uBE44\uAD50\uD558\uC138\uC694.\n\uCD5C\uC18C
        {0}\uBA85"
      - 'Take turns on individual canvases. Compare drawings during discussion.

        Minimum:
        {0} players'
      - "\u8F6E\u6D41\u5728\u5404\u81EA\u7684\u753B\u5E03\u4E0A\u753B\u3002\u8BA8\u8BBA\u65F6\u6BD4\u8F83\u5927\u5BB6\u7684\u753B\u3002\n\u81F3\u5C11
        {0} \u4EBA"
      - "\u8F2A\u6D41\u5728\u5404\u81EA\u7684\u756B\u5E03\u4E0A\u756B\u3002\u8A0E\u8AD6\u6642\u6BD4\u8F03\u5927\u5BB6\u7684\u756B\u3002\n\u81F3\u5C11
        {0} \u4EBA"
      - "\u5404\u81EA\u306E\u30AD\u30E3\u30F3\u30D0\u30B9\u306B\u9806\u756A\u3067\u63CF\u304D\u307E\u3059\u3002\u8A0E\u8AD6\u3067\u307F\u3093\u306A\u306E\u7D75\u3092\u6BD4\u3079\u307E\u3057\u3087\u3046\u3002\n\u6700\u4F4E
        {0} \u4EBA"
      - "Dibujen por turnos en lienzos individuales. Comparen los dibujos durante
        el debate.\nM\xEDnimo: {0} jugadores"
      - "Desenhem por turnos em telas individuais. Comparem os desenhos na discuss\xE3o.\nM\xEDnimo:
        {0} jogadores"
      - "Dessinez \xE0 tour de r\xF4le sur vos propres toiles. Comparez les dessins
        pendant la discussion.\nMinimum : {0} joueurs"
      - "Zeichnet abwechselnd auf eigenen Leinw\xE4nden. Vergleicht die Bilder in
        der Diskussion.\nMindestens {0} Spieler"
      - 'Bergiliran menggambar di kanvas masing-masing. Bandingkan gambar saat diskusi.

        Minimal:
        {0} pemain'
      - "\u092C\u093E\u0930\u0940-\u092C\u093E\u0930\u0940 \u0938\u0947 \u0905\u092A\u0928\u0947
        \u0915\u0948\u0928\u0935\u093E\u0938 \u092A\u0930 \u091A\u093F\u0924\u094D\u0930
        \u092C\u0928\u093E\u090F\u0902\u0964 \u091A\u0930\u094D\u091A\u093E \u092E\u0947\u0902
        \u091A\u093F\u0924\u094D\u0930\u094B\u0902 \u0915\u0940 \u0924\u0941\u0932\u0928\u093E
        \u0915\u0930\u0947\u0902\u0964\n\u0915\u092E \u0938\u0947 \u0915\u092E {0}
        \u0916\u093F\u0932\u093E\u0921\u093C\u0940"
      - "\u062A\u0646\u0627\u0648\u0628\u0648\u0627 \u0639\u0644\u0649 \u0627\u0644\u0631\u0633\u0645
        \u0639\u0644\u0649 \u0644\u0648\u062D\u0627\u062A\u0643\u0645 \u0627\u0644\u062E\u0627\u0635\u0629.
        \u0642\u0627\u0631\u0646\u0648\u0627 \u0627\u0644\u0631\u0633\u0648\u0645\u0627\u062A
        \u0623\u062B\u0646\u0627\u0621 \u0627\u0644\u0646\u0642\u0627\u0634.\n\u0627\u0644\u062D\u062F
        \u0627\u0644\u0623\u062F\u0646\u0649: {0} \u0644\u0627\u0639\u0628\u064A\u0646"
      Flags: 000000000000000000000000
      Languages_Touch: []
    - Term: UI/65287J207Ja06rCAIOyXhuuLpOuKlCDsnZjqsqzsl5Ag7LCs67CY7J2EIO2IrO2RnO2VtCDso7zshLjsmpQu
      TermType: 0
      Description: "\uB77C\uC774\uC5B4\uAC00 \uC5C6\uB2E4\uB294 \uC758\uACAC\uC5D0
        \uCC2C\uBC18\uC744 \uD22C\uD45C\uD574 \uC8FC\uC138\uC694."
      Languages:
      - "\uB77C\uC774\uC5B4\uAC00 \uC5C6\uB2E4\uB294 \uC758\uACAC\uC5D0 \uCC2C\uBC18\uC744
        \uD22C\uD45C\uD574 \uC8FC\uC138\uC694."
      - Vote for or against the claim that there is no liar.
      - "\u8BF7\u6295\u7968\u8D5E\u6210\u6216\u53CD\u5BF9\u201C\u6CA1\u6709\u8BF4\u8C0E\u8005\u201D\u7684\u5224\u65AD\u3002"
      - "\u8ACB\u6295\u7968\u8D0A\u6210\u6216\u53CD\u5C0D\u300C\u6C92\u6709\u8AAA\u8B0A\u8005\u300D\u7684\u5224\u65B7\u3002"
      - "\u300C\u30E9\u30A4\u30A2\u30FC\u306A\u3057\u300D\u306B\u8CDB\u6210\u304B\u53CD\u5BFE\u304B\u6295\u7968\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
      - Vota a favor o en contra de que no haya mentiroso.
      - "Vote a favor ou contra a ideia de que n\xE3o h\xE1 mentiroso."
      - "Votez pour ou contre l\u2019id\xE9e qu\u2019il n\u2019y a aucun menteur."
      - "Stimmt daf\xFCr oder dagegen, dass es keinen L\xFCgner gibt."
      - Pilih setuju atau tidak setuju bahwa tidak ada pembohong.
      - "\u0915\u094B\u0908 \u091D\u0942\u0920\u093E \u0928\u0939\u0940\u0902 \u0939\u0948,
        \u0907\u0938 \u0930\u093E\u092F \u0915\u0947 \u092A\u0915\u094D\u0937 \u092F\u093E
        \u0935\u093F\u092A\u0915\u094D\u0937 \u092E\u0947\u0902 \u0935\u094B\u091F
        \u0926\u0947\u0902\u0964"
      - "\u0635\u0648\u0651\u062A \u0628\u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629
        \u0623\u0648 \u0627\u0644\u0631\u0641\u0636 \u0639\u0644\u0649 \u0631\u0623\u064A
        \u0623\u0646\u0647 \u0644\u0627 \u064A\u0648\u062C\u062F \u0643\u0627\u0630\u0628."
      Flags: 000000000000000000000000
      Languages_Touch: []
    - Term: UI/65287J207Ja06rCAIOyXhuuLpOuKlCDsnZjqsqzsnbQg6rCA6rKw65CY7JeI7Ja07JqULiDsi6TsoJwg7Jet7ZWg7J2EIOqzteqwnO2VtOyalC4
      TermType: 0
      Description: "\uB77C\uC774\uC5B4\uAC00 \uC5C6\uB2E4\uB294 \uC758\uACAC\uC774
        \uAC00\uACB0\uB418\uC5C8\uC5B4\uC694. \uC2E4\uC81C \uC5ED\uD560\uC744 \uACF5\uAC1C\uD574\uC694."
      Languages:
      - "\uB77C\uC774\uC5B4\uAC00 \uC5C6\uB2E4\uB294 \uC758\uACAC\uC774 \uAC00\uACB0\uB418\uC5C8\uC5B4\uC694.
        \uC2E4\uC81C \uC5ED\uD560\uC744 \uACF5\uAC1C\uD574\uC694."
      - "\u201CNo Liar\u201D was approved. The actual roles will now be revealed."
      - "\u201C\u6CA1\u6709\u8BF4\u8C0E\u8005\u201D\u7684\u5224\u65AD\u5DF2\u901A\u8FC7\u3002\u73B0\u5728\u63ED\u6653\u771F\u5B9E\u8EAB\u4EFD\u3002"
      - "\u300C\u6C92\u6709\u8AAA\u8B0A\u8005\u300D\u7684\u5224\u65B7\u5DF2\u901A\u904E\u3002\u73FE\u5728\u63ED\u66C9\u771F\u5BE6\u8EAB\u5206\u3002"
      - "\u300C\u30E9\u30A4\u30A2\u30FC\u306A\u3057\u300D\u304C\u53EF\u6C7A\u3055\u308C\u307E\u3057\u305F\u3002\u5B9F\u969B\u306E\u5F79\u5272\u3092\u516C\u958B\u3057\u307E\u3059\u3002"
      - "Se aprob\xF3 \xABSin mentiroso\xBB. Ahora se revelan los roles reales."
      - "\u201CSem mentiroso\u201D foi aprovado. Os pap\xE9is reais ser\xE3o revelados."
      - "\xAB Aucun menteur \xBB a \xE9t\xE9 approuv\xE9. Les r\xF4les r\xE9els vont
        \xEAtre r\xE9v\xE9l\xE9s."
      - "\u201EKein L\xFCgner\u201C wurde angenommen. Die tats\xE4chlichen Rollen
        werden aufgedeckt."
      - "\u201CTidak Ada Pembohong\u201D disetujui. Peran sebenarnya akan diungkap."
      - "\u201C\u0915\u094B\u0908 \u091D\u0942\u0920\u093E \u0928\u0939\u0940\u0902\u201D
        \u0938\u094D\u0935\u0940\u0915\u093E\u0930 \u0939\u0941\u0906\u0964 \u0905\u092C
        \u0935\u093E\u0938\u094D\u0924\u0935\u093F\u0915 \u092D\u0942\u092E\u093F\u0915\u093E\u090F\u0902
        \u0926\u093F\u0916\u093E\u0908 \u091C\u093E\u090F\u0902\u0917\u0940\u0964"
      - "\u062A\u0645\u062A \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649
        \xAB\u0644\u0627 \u064A\u0648\u062C\u062F \u0643\u0627\u0630\u0628\xBB. \u0633\u062A\u064F\u0643\u0634\u0641
        \u0627\u0644\u0623\u062F\u0648\u0627\u0631 \u0627\u0644\u062D\u0642\u064A\u0642\u064A\u0629
        \u0627\u0644\u0622\u0646."
      Flags: 000000000000000000000000
      Languages_Touch: []
    - Term: UI/7LWc64ukIOuTne2RnCDrj5nrpaDsnYAg66y07J6R7JyE66GcIOqysOyglSDCtyDssqsg7LCs67CYIOuPmeyImOuKlCDrtoDqsrAsIOydtO2bhCDrj5nsoIQ
      TermType: 0
      Description: "\uCD5C\uB2E4 \uB4DD\uD45C \uB3D9\uB960\uC740 \uBB34\uC791\uC704\uB85C
        \uACB0\uC815 \xB7 \uCCAB \uCC2C\uBC18 \uB3D9\uC218\uB294 \uBD80\uACB0, \uC774\uD6C4
        \uB3D9\uC804"
      Languages:
      - "\uCD5C\uB2E4 \uB4DD\uD45C \uB3D9\uB960\uC740 \uBB34\uC791\uC704\uB85C \uACB0\uC815
        \xB7 \uCCAB \uCC2C\uBC18 \uB3D9\uC218\uB294 \uBD80\uACB0, \uC774\uD6C4 \uB3D9\uC804"
      - "Nomination ties are random \xB7 The first approval tie fails; later ties
        use a coin"
      - "\u6700\u9AD8\u7968\u5E73\u7968\u65F6\u968F\u673A\u51B3\u5B9A \xB7 \u9996\u6B21\u8D5E\u6210\u53CD\u5BF9\u5E73\u7968\u65F6\u5426\u51B3\uFF0C\u4E4B\u540E\u63B7\u786C\u5E01"
      - "\u6700\u9AD8\u7968\u5E73\u7968\u6642\u96A8\u6A5F\u6C7A\u5B9A \xB7 \u9996\u6B21\u8D0A\u6210\u53CD\u5C0D\u5E73\u7968\u6642\u5426\u6C7A\uFF0C\u4E4B\u5F8C\u64F2\u786C\u5E63"
      - "\u6700\u591A\u7968\u306E\u540C\u6570\u306F\u30E9\u30F3\u30C0\u30E0\u3067\u6C7A\u5B9A
        \xB7 \u6700\u521D\u306E\u8CDB\u5426\u540C\u6570\u306F\u5426\u6C7A\u3001\u4EE5\u964D\u306F\u30B3\u30A4\u30F3"
      - "Los empates de nominaci\xF3n son aleatorios \xB7 El primer empate de aprobaci\xF3n
        se rechaza; los siguientes se deciden con una moneda"
      - "Empates na indica\xE7\xE3o s\xE3o aleat\xF3rios \xB7 O primeiro empate de
        aprova\xE7\xE3o \xE9 rejeitado; os seguintes usam uma moeda"
      - "Les \xE9galit\xE9s de nomination sont al\xE9atoires \xB7 La premi\xE8re
        \xE9galit\xE9 d\u2019approbation est rejet\xE9e, les suivantes se jouent
        \xE0 pile ou face"
      - "Nominierungsgleichstand entscheidet der Zufall \xB7 Das erste Patt wird
        abgelehnt, sp\xE4tere per M\xFCnzwurf entschieden"
      - "Nominasi seri diputuskan acak \xB7 Persetujuan seri pertama ditolak; berikutnya
        ditentukan koin"
      - "\u0928\u093E\u092E\u093E\u0902\u0915\u0928 \u0915\u0940 \u092C\u0930\u093E\u092C\u0930\u0940
        \u0915\u093E \u092B\u0948\u0938\u0932\u093E \u092F\u093E\u0926\u0943\u091A\u094D\u091B\u093F\u0915
        \u0939\u0948 \xB7 \u092E\u0902\u091C\u0942\u0930\u0940 \u0915\u0940 \u092A\u0939\u0932\u0940
        \u092C\u0930\u093E\u092C\u0930\u0940 \u092A\u0930 \u0905\u0938\u094D\u0935\u0940\u0915\u093E\u0930,
        \u092C\u093E\u0926 \u092E\u0947\u0902 \u0938\u093F\u0915\u094D\u0915\u093E
        \u0909\u091B\u093E\u0932\u093E \u091C\u093E\u0924\u093E \u0939\u0948"
      - "\u064A\u064F\u062D\u0633\u0645 \u062A\u0639\u0627\u062F\u0644 \u0627\u0644\u062A\u0631\u0634\u064A\u062D
        \u0639\u0634\u0648\u0627\u0626\u064A\u064B\u0627 \xB7 \u064A\u064F\u0631\u0641\u0636
        \u0623\u0648\u0644 \u062A\u0639\u0627\u062F\u0644 \u0644\u0644\u0645\u0648\u0627\u0641\u0642\u0629\u060C
        \u0648\u062A\u064F\u062D\u0633\u0645 \u0627\u0644\u062A\u0639\u0627\u062F\u0644\u0627\u062A
        \u0627\u0644\u062A\u0627\u0644\u064A\u0629 \u0628\u0631\u0645\u064A \u0639\u0645\u0644\u0629"
      Flags: 000000000000000000000000
      Languages_Touch: []
