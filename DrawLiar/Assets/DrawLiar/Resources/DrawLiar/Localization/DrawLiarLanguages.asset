    - Term: UI/67Cp7J6l7J20IOu5hOuwgOuyiO2YuOulvCDshKTsoJXtlZwg65KkIOyeheyepe2VoCDsiJgg7J6I7Iq164uI64ukLg
      TermType: 0
      Description: "\uBC29\uC7A5\uC774 \uBE44\uBC00\uBC88\uD638\uB97C \uC124\uC815\uD55C
        \uB4A4 \uC785\uC7A5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      Languages:
      - "\uBC29\uC7A5\uC774 \uBE44\uBC00\uBC88\uD638\uB97C \uC124\uC815\uD55C \uB4A4
        \uC785\uC7A5\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
      - You can join after the host sets a password.
      - "\u30DB\u30B9\u30C8\u304C\u30D1\u30B9\u30EF\u30FC\u30C9\u3092\u8A2D\u5B9A\u3057\u3066\u304B\u3089\u5165\u5BA4\u3067\u304D\u307E\u3059\u3002"
      - "\u623F\u4E3B\u8BBE\u7F6E\u5BC6\u7801\u540E\u624D\u80FD\u52A0\u5165\u3002"
      - Du kannst beitreten, sobald der Gastgeber ein Passwort festgelegt hat.
      - "Vous pourrez rejoindre la salle une fois que l\u2019h\xF4te aura d\xE9fini
        un mot de passe."
      - "Podr\xE1s entrar cuando el anfitri\xF3n establezca una contrase\xF1a."
      - "Puede unirse despu\xE9s de que el anfitri\xF3n establezca una contrase\xF1a."
      - "Pode aderir depois que o anfitri\xE3o definir uma senha."
      - Puoi partecipare dopo che l'host ha impostato una password.
      - U kunt deelnemen nadat de host een wachtwoord heeft ingesteld.
      - "Du kan deltage, efter at v\xE6rten har angivet en adgangskode."
      - Du kan bli med etter at verten har angitt et passord.
      - "Du kan g\xE5 med efter att v\xE4rden har st\xE4llt in ett l\xF6senord."
      - "Voit liitty\xE4, kun is\xE4nt\xE4 on asettanut salasanan."
      - "Mo\u017Cesz do\u0142\u0105czy\u0107 po ustawieniu przez hosta has\u0142a."
      - "M\u016F\u017Eete se p\u0159ipojit pot\xE9, co hostitel nastav\xED heslo."
      - "M\xF4\u017Eete sa pripoji\u0165, ke\u010F hostite\u013E nastav\xED heslo."
      - "Akkor csatlakozhat, miut\xE1n a gazdag\xE9p be\xE1ll\xEDtott egy jelsz\xF3t."
      - "V\u0103 pute\u021Bi \xEEnscrie dup\u0103 ce gazda seteaz\u0103 o parol\u0103."
      - "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F
        \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
        \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442
        \u043F\u0430\u0440\u043E\u043B\u044C."
      - "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u0438\u0454\u0434\u043D\u0430\u0442\u0438\u0441\u044F
        \u043F\u0456\u0441\u043B\u044F \u0442\u043E\u0433\u043E, \u044F\u043A \u0433\u043E\u0441\u043F\u043E\u0434\u0430\u0440
        \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043F\u0430\u0440\u043E\u043B\u044C."
      - "Toplant\u0131 sahibi bir \u015Fifre belirledikten sonra kat\u0131labilirsiniz."
      - "\u064A\u0645\u0643\u0646\u0643 \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645
        \u0628\u0639\u062F \u0623\u0646 \u064A\u062D\u062F\u062F \u0627\u0644\u0645\u0636\u064A\u0641
        \u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631."
      - "\u05D0\u05EA\u05D4 \u05D9\u05DB\u05D5\u05DC \u05DC\u05D4\u05E6\u05D8\u05E8\u05E3
        \u05DC\u05D0\u05D7\u05E8 \u05E9\u05D4\u05DE\u05D0\u05E8\u05D7 \u05DE\u05D2\u05D3\u05D9\u05E8
        \u05E1\u05D9\u05E1\u05DE\u05D4."
      - "\u092E\u0947\u091C\u093C\u092C\u093E\u0928 \u0915\u0947 \u092A\u093E\u0938\u0935\u0930\u094D\u0921
        \u0924\u092F \u0915\u0930\u0928\u0947 \u0915\u0947 \u092C\u093E\u0926 \u0906\u092A
        \u092A\u094D\u0930\u0935\u0947\u0936 \u0915\u0930 \u0938\u0915\u0924\u0947
        \u0939\u0948\u0902\u0964"
      - Kamu bisa masuk setelah pemilik ruang menetapkan kata sandi.
      - "\u0E04\u0E38\u0E13\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E40\u0E02\u0E49\u0E32\u0E23\u0E48\u0E27\u0E21\u0E44\u0E14\u0E49\u0E2B\u0E25\u0E31\u0E07\u0E08\u0E32\u0E01\u0E17\u0E35\u0E48\u0E42\u0E2E\u0E2A\u0E15\u0E4C\u0E15\u0E31\u0E49\u0E07\u0E23\u0E2B\u0E31\u0E2A\u0E1C\u0E48\u0E32\u0E19\u0E41\u0E25\u0E49\u0E27"
