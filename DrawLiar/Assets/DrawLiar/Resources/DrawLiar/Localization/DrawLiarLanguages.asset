      Languages_Touch: []
    - Term: UI/7LqQ66at7YSw66W8IOuwmOynneydtOuKlCDrs7TshJ3snLzroZwg6rCQ7Iu47JqULg
      TermType: 0
      Description: "\uCE90\uB9AD\uD130\uB97C \uBC18\uC9DD\uC774\uB294 \uBCF4\uC11D\uC73C\uB85C
