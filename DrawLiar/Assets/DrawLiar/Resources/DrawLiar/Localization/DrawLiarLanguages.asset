        \u0628\u0631\u0645\u064A \u0639\u0645\u0644\u0629."
      - "\u05DE\u05D4\u05EA\u05D9\u05E7\u05D5 \u05D4\u05E9\u05E0\u05D9 \u05D1\u05E1\u05D9\u05D1\u05D5\u05D1
