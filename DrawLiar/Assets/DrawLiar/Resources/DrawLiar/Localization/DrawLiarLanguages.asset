      - "\u9700\u8981\u6AA2\u67E5\u4F3A\u670D\u5668\u7684 Google \u767B\u5165\u8A2D\u5B9A\u3002"
      - "\u30B5\u30FC\u30D0\u30FC\u306EGoogle\u30ED\u30B0\u30A4\u30F3\u8A2D\u5B9A\u3092\u78BA\u8A8D\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002"
