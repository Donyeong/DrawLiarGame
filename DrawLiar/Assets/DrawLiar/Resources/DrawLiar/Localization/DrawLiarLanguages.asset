        \u05E1\u05D9\u05D1\u05D5\u05D1\u05D9\u05DD: \u05DE\u05D5\u05E4\u05E2\u05DC\u05EA"
      - "\u091C\u093E\u0938\u0942\u0938 \u092E\u094B\u0921 \xB7 \u0932\u0915\u094D\u0937\u094D\u092F
        {0} \u0905\u0902\u0915 \xB7 \u092C\u0940\u091A \u092E\u0947\u0902 \u092A\u094D\u0930\u0935\u0947\u0936:
