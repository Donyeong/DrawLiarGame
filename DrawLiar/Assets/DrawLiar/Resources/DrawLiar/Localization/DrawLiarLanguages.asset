        \uC785\uB825\uD558\uC138\uC694."
      - Enter a 6-character room code.
      - "\u8BF7\u8F93\u51656\u4F4D\u5B57\u6BCD\u548C\u6570\u5B57\u7EC4\u6210\u7684\u623F\u95F4\u4EE3\u7801\u3002"
      - "\u8ACB\u8F38\u5165\u7531 6 \u4F4D\u82F1\u6587\u5B57\u6BCD\u8207\u6578\u5B57\u7D44\u6210\u7684\u623F\u9593\u4EE3\u78BC\u3002"
      - "\u82F1\u6570\u5B576\u6587\u5B57\u306E\u30EB\u30FC\u30E0\u30B3\u30FC\u30C9\u3092\u5165\u529B\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
