    - Term: UI/7JqU7LKt7J2EIOyymOumrO2VmOqzoCDsnojsirXri4jri6QuIOyeoOyLnCDquLDri6TroKQg7KO87IS47JqULg
      TermType: 0
      Description: "\uC694\uCCAD\uC744 \uCC98\uB9AC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
        \uC7A0\uC2DC \uAE30\uB2E4\uB824 \uC8FC\uC138\uC694."
      Languages:
      - "\uC694\uCCAD\uC744 \uCC98\uB9AC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uC7A0\uC2DC
        \uAE30\uB2E4\uB824 \uC8FC\uC138\uC694."
      - Processing your request. Please wait.
      - "\u30EA\u30AF\u30A8\u30B9\u30C8\u3092\u51E6\u7406\u3057\u3066\u3044\u307E\u3059\u3002\u3057\u3070\u3089\u304F\u304A\u5F85\u3061\u304F\u3060\u3055\u3044\u3002"
      - "\u6B63\u5728\u5904\u7406\u8BF7\u6C42\uFF0C\u8BF7\u7A0D\u5019\u3002"
      - Die Anfrage wird verarbeitet. Bitte warte kurz.
      - Traitement de la demande. Veuillez patienter.
      - Procesando la solicitud. Espera un momento.
      - Procesando su solicitud. Espere por favor.
      - "Processamento da sua solicita\xE7\xE3o. Por favor, aguarde."
      - Stiamo elaborando la tua richiesta. Attendere prego.
      - Het verwerken van uw aanvraag. Wacht alstublieft.
      - Behandler din anmodning. Vent venligst.
      - "Behandler foresp\xF8rselen din. Vennligst vent."
      - "Bearbetar din f\xF6rfr\xE5gan. V\xE4nta."
      - "Pyynt\xF6\xE4si k\xE4sitell\xE4\xE4n. Odota."
      - "Przetwarzanie Twojej pro\u015Bby. Prosz\u0119 czeka\u0107."
      - "Zpracov\xE1n\xED va\u0161eho po\u017Eadavku. \u010Cekejte pros\xEDm."
      - "Sprac\xFAva sa va\u0161a \u017Eiados\u0165. \u010Cakajte pros\xEDm."
      - "K\xE9r\xE9s\xE9nek feldolgoz\xE1sa folyamatban. K\xE9rj\xFCk, v\xE1rjon."
      - Procesarea cererii dvs. Va rugam asteptati.
      - "\u041E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u0432\u0430\u0448\u0435\u0433\u043E
        \u0437\u0430\u043F\u0440\u043E\u0441\u0430. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
        \u043F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435."
      - "\u041E\u0431\u0440\u043E\u0431\u043A\u0430 \u0432\u0430\u0448\u043E\u0433\u043E
        \u0437\u0430\u043F\u0438\u0442\u0443. \u0411\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430,
        \u0437\u0430\u0447\u0435\u043A\u0430\u0439\u0442\u0435."
      - "Talebiniz i\u015Fleniyor. L\xFCtfen bekleyin."
      - "\u062C\u0627\u0631\u064D \u0645\u0639\u0627\u0644\u062C\u0629 \u0627\u0644\u0637\u0644\u0628.
        \u0627\u0646\u062A\u0638\u0631 \u0642\u0644\u064A\u0644\u064B\u0627."
      - "\u05DE\u05E2\u05D1\u05D3 \u05D0\u05EA \u05D4\u05D1\u05E7\u05E9\u05D4 \u05E9\u05DC\u05DA.
        \u05D0\u05E0\u05D0 \u05D4\u05DE\u05EA\u05DF."
      - "\u0905\u0928\u0941\u0930\u094B\u0927 \u092A\u0930 \u0915\u093E\u092E \u0939\u094B
        \u0930\u0939\u093E \u0939\u0948\u0964 \u0915\u0943\u092A\u092F\u093E \u092A\u094D\u0930\u0924\u0940\u0915\u094D\u0937\u093E
        \u0915\u0930\u0947\u0902\u0964"
      - Permintaan sedang diproses. Harap tunggu.
      - "\u0E01\u0E33\u0E25\u0E31\u0E07\u0E1B\u0E23\u0E30\u0E21\u0E27\u0E25\u0E1C\u0E25\u0E04\u0E33\u0E02\u0E2D\u0E02\u0E2D\u0E07\u0E04\u0E38\u0E13
        \u0E42\u0E1B\u0E23\u0E14\u0E23\u0E2D."
      - "\u0110ang x\u1EED l\xFD y\xEAu c\u1EA7u c\u1EE7a b\u1EA1n. Vui l\xF2ng ch\u1EDD."
